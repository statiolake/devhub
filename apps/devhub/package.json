{
  "name": "@devhub/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fmt": "prettier --write src index.html package.json vite.config.ts eslint.config.js ../../contracts ../../scripts/check-terminal-contract.mjs ../../scripts/generate-terminal-contract.mjs",
    "fmt:check": "prettier --check src index.html package.json vite.config.ts eslint.config.js ../../contracts ../../scripts/check-terminal-contract.mjs ../../scripts/generate-terminal-contract.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.app.json --noEmit",
    "lint": "NODE_OPTIONS=--max-old-space-size=8192 eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "33.0.9",
    "@codingame/monaco-vscode-configuration-service-override": "33.0.9",
    "@codingame/monaco-vscode-dialogs-service-override": "33.0.9",
    "@codingame/monaco-vscode-environment-service-override": "33.0.9",
    "@codingame/monaco-vscode-explorer-service-override": "33.0.9",
    "@codingame/monaco-vscode-extensions-service-override": "33.0.9",
    "@codingame/monaco-vscode-files-service-override": "33.0.9",
    "@codingame/monaco-vscode-languages-service-override": "33.0.9",
    "@codingame/monaco-vscode-lifecycle-service-override": "33.0.9",
    "@codingame/monaco-vscode-log-service-override": "33.0.9",
    "@codingame/monaco-vscode-model-service-override": "33.0.9",
    "@codingame/monaco-vscode-quickaccess-service-override": "33.0.9",
    "@codingame/monaco-vscode-remote-agent-service-override": "33.0.9",
    "@codingame/monaco-vscode-search-service-override": "33.0.9",
    "@codingame/monaco-vscode-storage-service-override": "33.0.9",
    "@codingame/monaco-vscode-terminal-service-override": "33.0.9",
    "@codingame/monaco-vscode-textmate-service-override": "33.0.9",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "33.0.9",
    "@codingame/monaco-vscode-theme-service-override": "33.0.9",
    "@codingame/monaco-vscode-view-status-bar-service-override": "33.0.9",
    "@codingame/monaco-vscode-view-title-bar-service-override": "33.0.9",
    "@codingame/monaco-vscode-workbench-service-override": "33.0.9",
    "@codingame/monaco-vscode-workspace-trust-service-override": "33.0.9",
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "0.56.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.1.3",
    "vitest": "3.2.4"
