{
  // The main process: nodenext ESM, run by Electron as it is emitted (it is
  // not bundled; the packaged app carries the same tree, see
  // scripts/package-nightly.py). Parameter decorators and
  // `useDefineForClassFields: false` are what the code was written against
  // while it lived inside VS Code's DI container; nothing of VS Code is in the
  // program any more (docs/without-vscode.md).
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "legacy",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "out",
    "rootDir": "src"
  },
  "include": ["src/main", "src/ipc", "src/model"]
}
