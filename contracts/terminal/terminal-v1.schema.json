{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devhub://contracts/terminal/v1",
  "title": "DevHub Terminal PTY Channel v1",
  "description": "The checked-in source-of-truth fixture for the Rust and TypeScript terminal Channel contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "headerBytes",
    "frameKinds",
    "limits",
    "requests",
    "receipt",
    "errors",
    "exitReasons",
    "started",
    "outputMetadata",
    "errorMetadata",
    "exited"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "headerBytes": { "const": 8 },
    "frameKinds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started", "output", "exited", "error"],
      "properties": {
        "started": { "const": 1 },
        "output": { "const": 2 },
        "exited": { "const": 3 },
        "error": { "const": 4 }
      }
    },
    "limits": { "$ref": "#/$defs/limits" },
    "requests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attach", "input", "resize", "acknowledge", "detach"],
      "properties": {
        "attach": { "$ref": "#/$defs/attachRequest" },
        "input": { "$ref": "#/$defs/inputRequest" },
        "resize": { "$ref": "#/$defs/resizeRequest" },
        "acknowledge": { "$ref": "#/$defs/ackRequest" },
        "detach": { "$ref": "#/$defs/detachRequest" }
      }
    },
    "receipt": { "$ref": "#/$defs/receipt" },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSummaryBytes", "codes"],
      "properties": {
        "maxSummaryBytes": { "const": 256 },
        "codes": {
          "type": "array",
          "minItems": 14,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/errorCode" }
        }
      }
    },
    "exitReasons": {
      "type": "array",
      "items": { "enum": ["eof", "detached", "childExited"] },
      "minItems": 3,
      "uniqueItems": true
    },
    "started": { "$ref": "#/$defs/startedFrame" },
    "outputMetadata": { "$ref": "#/$defs/outputMetadata" },
    "errorMetadata": { "$ref": "#/$defs/errorFrame" },
    "exited": { "$ref": "#/$defs/exitedFrame" }
  },
  "$defs": {
    "schemaVersion": { "const": 1 },
    "surfaceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "attachmentId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "maxLength": 64
    },
    "targetGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cols", "rows", "pixelWidth", "pixelHeight"],
      "properties": {
        "cols": { "type": "integer", "minimum": 1, "maximum": 500 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 500 },
        "pixelWidth": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "pixelHeight": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "attachRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "surfaceKey",
        "targetGeneration",
        "cols",
        "rows",
        "pixelWidth",
        "pixelHeight"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "surfaceKey": { "$ref": "#/$defs/surfaceKey" },
        "targetGeneration": { "const": 0 },
        "cols": { "type": "integer", "minimum": 1, "maximum": 500 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 500 },
        "pixelWidth": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "pixelHeight": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "inputRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "surfaceKey",
        "attachmentId",
        "targetGeneration",
        "inputSequence",
        "bytes"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "surfaceKey": { "$ref": "#/$defs/surfaceKey" },
        "attachmentId": { "$ref": "#/$defs/attachmentId" },
        "targetGeneration": { "$ref": "#/$defs/targetGeneration" },
        "inputSequence": { "$ref": "#/$defs/targetGeneration" },
        "bytes": {
          "type": "array",
          "maxItems": 65536,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    },
    "resizeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "surfaceKey",
        "attachmentId",
        "targetGeneration",
        "cols",
        "rows",
        "pixelWidth",
        "pixelHeight"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "surfaceKey": { "$ref": "#/$defs/surfaceKey" },
        "attachmentId": { "$ref": "#/$defs/attachmentId" },
        "targetGeneration": { "$ref": "#/$defs/targetGeneration" },
        "cols": { "type": "integer", "minimum": 1, "maximum": 500 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 500 },
        "pixelWidth": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "pixelHeight": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "ackRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "surfaceKey",
        "attachmentId",
        "targetGeneration",
        "sequence"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "surfaceKey": { "$ref": "#/$defs/surfaceKey" },
        "attachmentId": { "$ref": "#/$defs/attachmentId" },
        "targetGeneration": { "$ref": "#/$defs/targetGeneration" },
        "sequence": { "$ref": "#/$defs/targetGeneration" }
      }
    },
    "detachRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "surfaceKey",
        "attachmentId",
        "targetGeneration"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "surfaceKey": { "$ref": "#/$defs/surfaceKey" },
        "attachmentId": { "$ref": "#/$defs/attachmentId" },
        "targetGeneration": { "$ref": "#/$defs/targetGeneration" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "attachmentId",
        "surfaceKey",
        "targetGeneration"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "attachmentId": { "$ref": "#/$defs/attachmentId" },
        "surfaceKey": { "$ref": "#/$defs/surfaceKey" },
        "targetGeneration": { "$ref": "#/$defs/targetGeneration" }
      }
    },
    "errorCode": {
      "enum": [
        "invalid_request",
        "invalid_surface",
        "surface_unavailable",
        "stale_target",
        "wrong_attachment",
        "attachment_limit",
        "session_unavailable",
        "pty_unavailable",
        "input_too_large",
        "invalid_resize",
        "channel_closed",
        "backpressure",
        "runtime_unavailable",
        "internal"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "summary"],
      "properties": {
        "code": { "$ref": "#/$defs/errorCode" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "startedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schemaVersion",
        "attachmentId",
        "sequence",
        "surfaceKey",
        "targetGeneration",
        "cols",
        "rows"
      ],
      "properties": {
        "type": { "const": "started" },
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "attachmentId": { "$ref": "#/$defs/attachmentId" },
        "sequence": { "const": 0 },
        "surfaceKey": { "$ref": "#/$defs/surfaceKey" },
        "targetGeneration": { "$ref": "#/$defs/targetGeneration" },
        "cols": { "type": "integer", "minimum": 1, "maximum": 500 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "outputMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "schemaVersion", "attachmentId", "sequence"],
      "properties": {
        "type": { "const": "output" },
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "attachmentId": { "$ref": "#/$defs/attachmentId" },
        "sequence": { "$ref": "#/$defs/targetGeneration" }
      }
    },
    "errorFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schemaVersion",
        "attachmentId",
        "sequence",
        "error"
      ],
      "properties": {
        "type": { "const": "error" },
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "attachmentId": { "$ref": "#/$defs/attachmentId" },
        "sequence": { "const": 0 },
        "error": { "$ref": "#/$defs/error" }
      }
    },
    "exitedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "schemaVersion",
        "attachmentId",
        "sequence",
        "reason"
      ],
      "properties": {
        "type": { "const": "exited" },
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "attachmentId": { "$ref": "#/$defs/attachmentId" },
        "sequence": { "$ref": "#/$defs/targetGeneration" },
        "reason": { "enum": ["eof", "detached", "childExited"] }
      }
    }
  }
}
