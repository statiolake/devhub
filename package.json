{
  "name": "devhub",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @devhub/desktop build && apps/desktop/scripts/dev.sh",
    "fmt": "pnpm --filter @devhub/desktop fmt:check",
    "lint": "pnpm --filter @devhub/desktop lint",
    "typecheck": "pnpm --filter @devhub/desktop typecheck",
    "test": "pnpm --filter @devhub/desktop test && pnpm run test:scripts && pnpm run test:cli",
    "test:scripts": "python3 -m unittest discover -s scripts -p '*_test.py'",
    "test:cli": "cd cli && test -z \"$(gofmt -l .)\" && go vet ./... && go test ./...",
    "test:local": "scripts/test-local.sh",
    "build": "scripts/build-app.sh",
    "smoke": "scripts/smoke_packaged_app.py dist/DevHub.app",
    "build:packages": "pnpm --filter @devhub/desktop build",
    "check": "pnpm run fmt && pnpm run lint && pnpm run typecheck && pnpm run test"
  }
}
