# Local/editor noise
.DS_Store
.idea/
.vscode/

# Rust and JavaScript build output
target/
**/target/
node_modules/
**/node_modules/
apps/desktop/out/
apps/desktop/dist/

# The Node version vscode/'s build pins, fetched by scripts/provision-vscode.sh
vscode-toolchain/

# Throwaway spike scratch (captures, logs, sample folders)
.spike/

# DevHub build caches
apps/desktop/.vite/
extensions/devhub-bridge/dist/
extensions/devhub-bridge/build/
.pnpm-store/
.pnpm-debug.log*

# Python caches
__pycache__/

# Runtime and test leftovers
# Scratch the unit tests write to: never $TMPDIR, so the path is the same
# inside and outside a sandbox.
apps/desktop/.test-scratch/
*.log
*.tmp
*.swp

# Credentials and release payloads
*.pem
*.key
*.p12
*.dmg
*.zip
*.app/
