# Local/editor noise
.DS_Store
.idea/
.vscode/

# Build output
node_modules/
**/node_modules/
apps/desktop/out/
apps/desktop/dist/

# What the removed VS Code submodule left in a checkout that had provisioned
# it (docs/without-vscode.md): nothing reads these any more, and they can be
# deleted by hand.
/vscode/
/vscode-toolchain/
/vscode-reh-*/

# Where scripts/build_tmux.py downloads, unpacks and builds tmux and its two
# dependencies. Kept between runs so a second one reuses the verified
# downloads; hundreds of megabytes of upstream sources and object files.
tmux-build/
# ...and where scripts/build_bash.py does the same for bash.
bash-build/
tools-build/

# Throwaway spike scratch (captures, logs, sample folders)
.spike/

# DevHub build caches
apps/desktop/.vite/
extensions/devhub-bridge/build/
extensions/devhub-remote/dist/
extensions/devhub-remote/build/
extensions/devhub-copilot/dist/
extensions/devhub-copilot/server/
.pnpm-store/
.pnpm-debug.log*

# Python caches
__pycache__/

# Runtime and test leftovers
# Scratch the unit tests write to: never $TMPDIR, so the path is the same
# inside and outside a sandbox.
apps/desktop/.test-scratch/
*.log
*.tmp
*.swp

# Credentials and release payloads
*.pem
*.key
*.p12
*.dmg
*.zip
*.app/
# Where scripts/build-app.sh and scripts/build_reh.py leave what they made.
# `*.zip` and `*.app/` already covered the app; the server tarballs are a
# quarter of a gigabyte each and would otherwise be one `git add .` from the
# history.
dist/
