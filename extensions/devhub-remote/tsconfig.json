{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["node", "vscode"]
  },
  "include": [
    "src/**/*.ts",
    "../../vscode/src/vscode-dts/vscode.proposed.resolvers.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
