{
  "name": "devhub-remote",
  "displayName": "DevHub Remote",
  "description": "DevHub's built-in ssh-remote and dev-container authority resolvers, and the editor's Reopen in Container / Reopen Folder Locally / Switch Container: they ask the running DevHub over its control socket.",
  "version": "0.1.0",
  "publisher": "devhub",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.109.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "ui"
  ],
  "api": "none",
  "enabledApiProposals": [
    "resolvers"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onResolveRemoteAuthority:ssh-remote",
    "onResolveRemoteAuthority:dev-container",
    "onStartupFinished"
  ],
  "contributes": {
    "resourceLabelFormatters": [
      {
        "scheme": "vscode-remote",
        "authority": "ssh-remote+*",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "tildify": true,
          "workspaceSuffix": "SSH"
        }
      },
      {
        "scheme": "vscode-remote",
        "authority": "dev-container+*",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "tildify": true,
          "workspaceSuffix": "Dev Container"
        }
      }
    ],
    "commands": [
      {
        "command": "devhub.reopenInContainer",
        "title": "Reopen in Container",
        "category": "Dev Containers"
      },
      {
        "command": "devhub.reopenLocally",
        "title": "Reopen Folder Locally",
        "category": "Dev Containers"
      },
      {
        "command": "devhub.switchContainer",
        "title": "Switch Container",
        "category": "Dev Containers"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "devhub.reopenInContainer",
          "when": "remoteName != dev-container && remoteName != ssh-remote && devhub.devContainerConfigs > 0"
        },
        {
          "command": "devhub.reopenLocally",
          "when": "remoteName == dev-container"
        },
        {
          "command": "devhub.switchContainer",
          "when": "remoteName == dev-container && devhub.devContainerConfigs > 1"
        }
      ],
      "statusBar/remoteIndicator": [
        {
          "command": "devhub.reopenInContainer",
          "when": "remoteName != dev-container && remoteName != ssh-remote && devhub.devContainerConfigs > 0",
          "group": "remote_20_devhub@1"
        },
        {
          "command": "devhub.reopenLocally",
          "when": "remoteName == dev-container",
          "group": "remote_20_devhub@2"
        },
        {
          "command": "devhub.switchContainer",
          "when": "remoteName == dev-container && devhub.devContainerConfigs > 1",
          "group": "remote_20_devhub@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "reproducible": "node scripts/reproducible.mjs",
    "fmt:check": "prettier --check src scripts test package.json tsconfig.json README.md",
    "fmt": "prettier --write src scripts test package.json tsconfig.json README.md",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run package && pnpm run reproducible"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.109.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
