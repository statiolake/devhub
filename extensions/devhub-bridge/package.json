{
  "name": "@devhub/bridge",
  "displayName": "DevHub Bridge",
  "description": "DevHub's built-in VS Code integration: the workbench defaults DevHub owes an answer for.",
  "version": "0.1.0",
  "publisher": "devhub",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.109.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configurationDefaults": {
      "window.title": "${dirty}${activeEditorShort}",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": false,
      "workbench.startupEditor": "none",
      "chat.disableAIFeatures": true
    }
  },
  "scripts": {
    "package": "node scripts/package.mjs",
    "reproducible": "node scripts/reproducible.mjs",
    "fmt:check": "prettier --check scripts package.json README.md",
    "fmt": "prettier --write scripts package.json README.md",
    "lint": "node scripts/check.mjs",
    "check": "pnpm run lint && pnpm run package && pnpm run reproducible"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
