{
  "name": "@devhub/bridge",
  "displayName": "DevHub Bridge",
  "description": "DevHub's built-in VS Code integration: the workbench defaults DevHub owes an answer for, and the command that installs the 'devhub' launcher.",
  "version": "0.1.0",
  "publisher": "devhub",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.109.0"
  },
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onCommand:devhub.installCli"
  ],
  "contributes": {
    "configurationDefaults": {
      "window.title": "${dirty}${activeEditorShort}",
      "window.commandCenter": false,
      "workbench.layoutControl.enabled": false,
      "workbench.startupEditor": "none",
      "chat.disableAIFeatures": true
    },
    "commands": [
      {
        "command": "devhub.installCli",
        "title": "DevHub: Install 'devhub' command in PATH"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "reproducible": "node scripts/reproducible.mjs",
    "fmt:check": "prettier --check src scripts test package.json tsconfig.json README.md",
    "fmt": "prettier --write src scripts test package.json tsconfig.json README.md",
    "lint": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run lint && pnpm run package && pnpm run reproducible"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/vscode": "1.109.0",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
