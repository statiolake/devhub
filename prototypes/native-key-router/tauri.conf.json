{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevHub F0.3 native key router",
  "version": "0.0.0",
  "identifier": "io.github.statiolake.devhub.prototype.native-key-router",
  "build": {
    "frontendDist": "src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevHub F0.3 — native keyboard / IME harness",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

