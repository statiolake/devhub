{
  "name": "devhub-real-workbench-native-input",
  "displayName": "DevHub real Workbench native input gate",
  "description": "Throwaway public-API diagnostic extension for the F0.2/F0.3 gate.",
  "version": "0.0.1",
  "publisher": "devhub",
  "license": "MIT",
  "engines": {
    "vscode": "^1.109.0"
  },
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "devhub.realNativeInput.q",
        "title": "F0.3 test: native Command-Q received"
      }
    ],
    "keybindings": [
      {
        "command": "devhub.realNativeInput.q",
        "key": "cmd+q",
        "mac": "cmd+q",
        "when": "editorTextFocus"
      }
    ]
  }
}
