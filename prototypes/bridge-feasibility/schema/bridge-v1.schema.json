{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devhub.local/prototypes/bridge-feasibility/bridge-v1.schema.json",
  "title": "DevHub Bridge v1 envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "connection_id", "sequence", "message_id", "kind", "payload"],
  "properties": {
    "version": { "const": 1 },
    "connection_id": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/uuid" }] },
    "sequence": { "type": "integer", "minimum": 1 },
    "message_id": { "$ref": "#/$defs/uuid" },
    "kind": {
      "enum": [
        "hello", "hello_accepted", "state_snapshot", "ready_changed", "identity_changed",
        "dirty_changed", "open_workspace_requested", "new_window_requested",
        "request_state_snapshot", "focus", "response", "error"
      ]
    },
    "payload": { "type": "object" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "context": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "global" } } },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "workspace_id", "canonical_root"],
          "properties": {
            "kind": { "const": "workspace" },
            "workspace_id": { "$ref": "#/$defs/uuid" },
            "canonical_root": { "type": "string", "pattern": "^/[^\\u0000]*$" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "hello" } } },
      "then": {
        "properties": {
          "connection_id": { "const": null },
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": ["extension_version", "surface_id", "workbench_instance_id"],
            "properties": {
              "extension_version": { "type": "string" },
              "surface_id": { "$ref": "#/$defs/uuid" },
              "workbench_instance_id": { "$ref": "#/$defs/uuid" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "state_snapshot" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object", "additionalProperties": false,
            "required": ["surface_id", "readiness", "context", "dirty"],
            "properties": {
              "surface_id": { "$ref": "#/$defs/uuid" },
              "readiness": { "enum": ["starting", "ready", "unavailable"] },
              "context": { "$ref": "#/$defs/context" },
              "dirty": { "type": "boolean" }
            }
          }
        }
      }
    }
  ]
}
