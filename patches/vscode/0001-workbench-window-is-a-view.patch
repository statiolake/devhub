+			const devhubCreateWindow = (globalThis as { __devhubCreateWindow?: (options: electron.BrowserWindowConstructorOptions, purpose: 'workbench' | 'extension-development-host') => electron.BrowserWindow }).__devhubCreateWindow;
+			if (typeof devhubCreateWindow !== 'function') {
+				throw new Error('DevHub: __devhubCreateWindow is not installed');
+			}
+			this._win = devhubCreateWindow(options, config.extensionDevelopmentPath?.length ? 'extension-development-host' : 'workbench');
 			mark('code/didCreateCodeBrowserWindow');
 
 			this._id = this._win.id;
