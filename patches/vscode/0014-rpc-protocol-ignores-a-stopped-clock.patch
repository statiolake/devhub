+	/**
+	 * DevHub: freezes a workbench by stopping its renderer and extension host
+	 * (SIGSTOP). A check that runs long after it was due is a check whose own
+	 * process was not running — stopped, or blocked — so it cannot say the other
+	 * side was slow: the countdown starts again from now instead.
+	 */
+	private _unresponsiveCheckDue = 0;
