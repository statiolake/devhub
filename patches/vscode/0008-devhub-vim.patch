+			items.reverse();
+		}
+		let out = items.map(x => x.line);
+		if (unique) {
+			out = out.filter((l, i) => i === 0 || (ic ? l.toLowerCase() !== out[i - 1].toLowerCase() : l !== out[i - 1]));
+		}
