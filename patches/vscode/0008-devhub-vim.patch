+type Parse =
+	| { status: 'incomplete' }
+	| { status: 'invalid' }
+	| { status: 'done' };
+
+interface LastChange {
+	register: string | undefined;
+	count: number | undefined;
+	keys: string[];
+	insertText?: string;
