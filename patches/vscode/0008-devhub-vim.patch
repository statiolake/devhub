index 00000000..c0fb8f4f
--- /dev/null
+++ b/src/vs/workbench/contrib/devhubVim/common/vimKeymap.ts
@@ -0,0 +1,223 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) DevHub contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// DevHub native Vim: the default keymap, as data. Imports nothing.
+//
+// Every entry becomes an ordinary default keybinding (KeybindingsRegistry, in
+// ../browser/devhubVim.contribution.ts): it is listed in the Keyboard
+// Shortcuts editor, `keybindings.json` overrides it, and `-command` removes it.
+// The tests resolve keys against this same table, so what is tested is what
+// ships.
+//
+// Keys are written in keybindings.json notation for a US layout. On macOS
+// VS Code dispatches by physical key but resolves letters and the punctuation
+// keys by the character they produce (`shift+;` is "the key that types `:`",
+// on a JIS keyboard the unshifted `:` key), so those work on any layout. The
+// shifted digits are the exception: `shift+6` is always Shift + the 6 key,
+// which types `^` only on US-like layouts (`&` on JIS). Bindings on shifted
+// digits are therefore gated on `devhubVim.usShiftedDigits`; on other layouts
+// the editor dispatches those characters (! @ # $ % ^ & * ( )) by character
+// to the same default entry (`layoutFallback`), because VS Code's notation
+// cannot name, e.g., JIS `^` other than by scan code (`[Equal]`).
+
+export interface VimKeybinding {
+	/** keybindings.json notation; two chords are separated by a space ("g g"). */
+	readonly key: string;
+	readonly command: string;
+	readonly args?: Readonly<Record<string, unknown>>;
+	/** A when clause, without the shifted-digit gate (see `effectiveWhen`). */
+	readonly when: string;
+	/** `override`: outranks workbench-wide defaults (Ctrl-R is Open Recent on macOS); `escape`: Esc's own weight. */
+	readonly weight?: 'override' | 'escape';
+}
+
+const BASE = 'editorTextFocus && devhubVim.active';
+const MOTION = `${BASE} && devhubVim.acceptsMotion`;
+
+/** The when clauses the defaults use; copy them for your own bindings. */
+export const VIM_WHEN = {
+	/** normal, visual and operator-pending mode, nothing else pending (count/register/operator allowed) */
+	motion: MOTION,
+	/** as `motion`, but only when nothing is pending: arrows are the editor's own once an operator waits */
+	arrow: `${MOTION} && !devhubVim.pending`,
+	normal: `${MOTION} && devhubVim.mode == 'normal'`,
+	/** normal or visual, not operator-pending */
+	normalOrVisual: `${MOTION} && devhubVim.mode != 'operatorPending'`,
+	visual: `${MOTION} && (devhubVim.mode == 'visual' || devhubVim.mode == 'visualLine')`,
+	/** where `i` / `a` start a text object */
+	textObjectPrefix: `${MOTION} && devhubVim.mode != 'normal'`,
+	/** after `i` / `a`: the key names the object */
+	textObject: `${BASE} && devhubVim.textObjectPending`,
+	countZero: `${MOTION} && devhubVim.hasCount`,
+	lineStart: `${MOTION} && !devhubVim.hasCount`,
+	recording: `${MOTION} && devhubVim.mode == 'normal' && devhubVim.recording`,
+	notRecording: `${MOTION} && devhubVim.mode == 'normal' && !devhubVim.recording`,
+	escape: `devhubVim.active && devhubVim.mode != 'nav'`,
+} as const;
+
+const W = VIM_WHEN;
+
+function motion(key: string, name: string, when: string = W.motion): VimKeybinding {
+	return { key, command: 'devhubVim.motion', args: { motion: name }, when };
+}
+
+function awaitChar(key: string, command: string, args: Record<string, unknown> | undefined, when: string): VimKeybinding {
+	return { key, command: 'devhubVim.awaitChar', args: { then: args ? { command, args } : { command } }, when };
+}
+
+function action(key: string, name: string, when: string, weight?: 'override'): VimKeybinding {
+	return { key, command: 'devhubVim.action', args: { action: name }, when, ...(weight ? { weight } : {}) };
+}
+
+function operator(key: string, name: string): VimKeybinding {
+	return { key, command: 'devhubVim.operator', args: { operator: name }, when: W.motion };
+}
+
+function mode(key: string, to: string, at: string | undefined, when: string): VimKeybinding {
+	return { key, command: 'devhubVim.mode', args: at ? { to, at } : { to }, when };
+}
+
+function textObject(key: string, object: string): VimKeybinding {
+	return { key, command: 'devhubVim.textObject', args: { object }, when: W.textObject };
+}
+
+export const DEFAULT_KEYBINDINGS: readonly VimKeybinding[] = [
+	{ key: 'escape', command: 'devhubVim.escape', when: W.escape, weight: 'escape' },
+
+	// motions (they compose with a count, an operator and visual mode)
+	motion('h', 'left'), motion('backspace', 'left'), motion('left', 'left', W.arrow),
+	motion('j', 'down'), motion('down', 'down', W.arrow),
+	motion('k', 'up'), motion('up', 'up', W.arrow),
+	motion('l', 'right'), motion('space', 'right'), motion('right', 'right', W.arrow),
+	motion('w', 'wordForward'), motion('shift+w', 'WORDForward'),
+	motion('b', 'wordBackward'), motion('shift+b', 'WORDBackward'),
+	motion('e', 'wordEnd'), motion('shift+e', 'WORDEnd'),
