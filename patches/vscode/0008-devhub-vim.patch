+	test('plain keys', () => {
+		assert.strictEqual(toVimKey(ev('j'), false), 'j');
+		assert.strictEqual(toVimKey(ev('G'), false), 'G');
+		assert.strictEqual(toVimKey(ev('Enter'), false), '<CR>');
+		assert.strictEqual(toVimKey(ev('ArrowDown'), false), 'j');
+		assert.strictEqual(toVimKey(ev('ArrowDown'), true), undefined);
+		assert.strictEqual(toVimKey(ev('Tab'), false), '<Tab>');
+		assert.strictEqual(toVimKey(ev('Escape'), false), undefined);
+	});
+
+	test('modifiers', () => {
+		assert.strictEqual(toVimKey(ev('c', { metaKey: true }), false), undefined);
+		assert.strictEqual(toVimKey(ev('j', { altKey: true }), false), undefined);
+		assert.strictEqual(toVimKey(ev('r', { ctrlKey: true }), false), '<C-r>');
+		assert.strictEqual(toVimKey(ev('x', { ctrlKey: true }), false), undefined);
+	});
+
+	test('IME keys are the IME\'s, never Vim keys', () => {
+		assert.strictEqual(toVimKey(ev('Process', { keyCode: 229 }), false), undefined);
+		assert.strictEqual(toVimKey(ev('j', { keyCode: 229 }), false), undefined);
+		assert.strictEqual(toVimKey(ev('u', { isComposing: true }), false), undefined);
+		assert.strictEqual(toVimKey(ev('Enter', { isComposing: true }), false), undefined);
+	});
+});
