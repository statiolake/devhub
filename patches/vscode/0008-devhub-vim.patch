+	private enterInsert(at: VimPos, count: number, change: LastChange | undefined, repeat: InsertSession['repeat']): void {
+		this._mode = 'insert';
+		this.host.setCursor(at);
+		this.insert = { start: at, count, change, backspaced: 0, repeat };
+	}
