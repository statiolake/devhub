+					}
+				}
+				if (remove) {
+					edits.push({ start: pos(l, 0), end: pos(l, remove), text: '' });
+				}
+			}
+		}
+		this.edit(edits);
+		this.setNormalCursor(pos(from, this.firstNonBlank(from)));
+	}
+
+	private join(line: number, count: number): void {
+		const last = Math.min(this.lastLine(), line + count - 1);
+		if (last === line) {
+			return;
+		}
+		const edits: VimEdit[] = [];
+		let joinedLength = this.len(line);
+		let cursorCol = 0;
+		for (let l = line; l < last; l++) {
+			const cur = this.host.lineText(l);
+			const next = this.host.lineText(l + 1);
+			const fnb = this.firstNonBlank(l + 1);
+			const rest = next.slice(fnb);
+			const curJoined = l === line ? cur : 'x'; // only "ends with blank" matters below
+			const sep = rest === '' || rest.startsWith(')') || /\s$/.test(curJoined) || (l === line && cur === '') ? '' : ' ';
+			edits.push({ start: pos(l, cur.length), end: pos(l + 1, fnb), text: sep });
+			cursorCol = joinedLength;
+			joinedLength += sep.length + rest.length;
+		}
+		this.edit(edits);
+		this.closeChange();
+		this.setNormalCursor(pos(line, cursorCol));
+	}
+
+	private put(register: string | undefined, count: number, before: boolean, cur: VimPos): void {
+		const reg = this.readRegister(register);
+		if (!reg) {
+			return;
+		}
+		if (reg.linewise) {
+			const block = new Array(count).fill(reg.text).join('\n');
+			if (before) {
+				this.edit([{ start: pos(cur.line, 0), end: pos(cur.line, 0), text: block + '\n' }]);
+				this.closeChange();
+				this.setNormalCursor(pos(cur.line, this.firstNonBlank(cur.line)));
+			} else {
+				const eol = pos(cur.line, this.len(cur.line));
+				this.edit([{ start: eol, end: eol, text: '\n' + block }]);
+				this.closeChange();
+				this.setNormalCursor(pos(cur.line + 1, this.firstNonBlank(cur.line + 1)));
+			}
+			return;
+		}
+		const text = reg.text.repeat(count);
+		const at = before || this.len(cur.line) === 0 ? cur : pos(cur.line, cur.col + 1);
+		this.edit([{ start: at, end: at, text }]);
+		this.closeChange();
+		const end = this.endOfInsertedText(at, text);
+		this.setNormalCursor(pos(end.line, end.col - 1));
+	}
+
+
+	// ---- motions ------------------------------------------------------------
+
+	/** Where motion `name` goes from `cur`; undefined when it goes nowhere (no match). */
+	private motion(name: string, count: number | undefined, forOperator: boolean, cur: VimPos, ch: string | undefined): MotionResult | undefined {
+		const n = count ?? 1;
+		const last = this.lastLine();
+		const find = FIND_MOTIONS[name];
+		if (find) {
+			if (!ch) {
+				this.invalid();
+			}
+			this.shared.lastFind = { key: find, char: ch };
+			return this.findInLine(cur, find, ch, n, false);
+		}
+		switch (name) {
+			case 'left':
+				return { pos: pos(cur.line, Math.max(0, cur.col - n)) };
+			case 'right': {
+				const max = forOperator ? this.len(cur.line) : Math.max(0, this.len(cur.line) - 1);
+				return { pos: pos(cur.line, Math.min(max, cur.col + n)) };
+			}
+			case 'down': case 'up': case 'halfPageDown': case 'halfPageUp': {
+				const half = name === 'halfPageDown' || name === 'halfPageUp';
+				const step = half ? Math.max(1, Math.floor(this.host.visibleLineCount() / 2)) * n : n;
+				const down = name === 'down' || name === 'halfPageDown';
+				const line = Math.max(0, Math.min(last, cur.line + (down ? step : -step)));
+				if (line === cur.line && forOperator) {
+					return undefined;
+				}
+				return { pos: pos(line, this.desiredColFor(line)), linewise: true, vertical: true };
+			}
+			case 'nextLineStart': case 'previousLineStart': case 'currentLineStart': {
+				const delta = name === 'previousLineStart' ? -n : name === 'currentLineStart' ? n - 1 : n;
+				const line = Math.max(0, Math.min(last, cur.line + delta));
+				return { pos: pos(line, this.firstNonBlank(line)), linewise: true };
+			}
+			case 'lineStart':
+				return { pos: pos(cur.line, 0) };
+			case 'firstNonBlank':
+				return { pos: pos(cur.line, this.firstNonBlank(cur.line)) };
+			case 'lineEnd': {
+				const line = Math.min(last, cur.line + n - 1);
+				return { pos: pos(line, Math.max(0, this.len(line) - 1)), inclusive: true };
+			}
+			case 'fileEnd': case 'fileStart': {
+				const line = count === undefined ? (name === 'fileEnd' ? last : 0) : Math.max(0, Math.min(last, count - 1));
+				return { pos: pos(line, this.firstNonBlank(line)), linewise: true };
+			}
+			case 'wordForward': case 'WORDForward': {
+				let p = cur;
+				for (let c = 0; c < n; c++) {
+					p = this.wordForward(p, name === 'WORDForward');
+				}
+				return { pos: p };
+			}
+			case 'wordBackward': case 'WORDBackward': {
+				let p = cur;
+				for (let c = 0; c < n; c++) {
+					p = this.wordBackward(p, name === 'WORDBackward');
+				}
+				return { pos: p };
+			}
+			case 'wordEnd': case 'WORDEnd':
+				return { pos: this.wordEnd(cur, name === 'WORDEnd', n, false), inclusive: true };
+			case 'wordEndBackward': case 'WORDEndBackward':
+				return { pos: this.wordEndBackward(cur, name === 'WORDEndBackward', n), inclusive: true };
+			case 'repeatFind': case 'repeatFindReverse': {
+				const lf = this.shared.lastFind;
+				if (!lf) {
+					return undefined;
+				}
+				let k = lf.key;
+				if (name === 'repeatFindReverse') {
+					k = k === 'f' ? 'F' : k === 'F' ? 'f' : k === 't' ? 'T' : 't';
+				}
+				return this.findInLine(cur, k, lf.char, n, true);
+			}
+			case 'matchBracket':
+				return this.matchBracket(cur);
+			case 'searchNext': case 'searchPrevious': {
+				const ls = this.shared.lastSearch;
+				if (!ls) {
+					return undefined;
+				}
+				const back = name === 'searchPrevious' ? !ls.backwards : ls.backwards;
+				return this.searchMotion(ls.pattern, back, cur, n);
+			}
+			case 'searchWordForward': case 'searchWordBackward': {
+				const word = this.wordUnderCursor(cur);
+				if (!word) {
+					return undefined;
+				}
+				const backwards = name === 'searchWordBackward';
+				const pattern = isWordChar(word[0]) ? `\\b${escapeRegExp(word)}\\b` : escapeRegExp(word);
+				this.shared.lastSearch = { pattern, backwards };
+				return this.searchMotion(pattern, backwards, cur, n);
+			}
+		}
+		this.invalid(`Unknown motion: ${name}`);
+	}
+
+	private desiredColFor(line: number): number {
+		return Math.min(this.desiredCol, Math.max(0, this.len(line) - 1));
+	}
+
+	private searchMotion(pattern: string, backwards: boolean, cur: VimPos, n: number): MotionResult | undefined {
+		let p = cur;
+		for (let c = 0; c < n; c++) {
+			const from = backwards ? p : (p.col < this.len(p.line) ? pos(p.line, p.col + 1) : p);
+			const found = this.host.find(pattern, from, backwards);
+			if (!found) {
+				this.message = `Pattern not found: ${pattern}`;
+				return undefined;
+			}
+			p = found;
+		}
+		return { pos: p };
+	}
+
+	private wordUnderCursor(cur: VimPos): string | undefined {
+		const text = this.host.lineText(cur.line);
+		let c = cur.col;
+		while (c < text.length && !isWordChar(text[c])) {
+			c++;
+		}
+		if (c >= text.length) {
+			return undefined;
+		}
+		let s = c;
+		let e = c;
+		while (s > 0 && isWordChar(text[s - 1])) {
+			s--;
+		}
+		while (e < text.length && isWordChar(text[e])) {
+			e++;
+		}
+		return text.slice(s, e);
+	}
+
+	private isEmptyLine(p: VimPos): boolean {
+		return p.col === 0 && this.len(p.line) === 0;
+	}
+
+	private wordForward(start: VimPos, big: boolean): VimPos {
+		let p = start;
+		const cls = charClass(this.charAt(p), big);
+		if (cls !== 0) {
+			for (; ;) {
+				const nx = this.nextChar(p);
+				if (!nx) {
+					return pos(p.line, this.len(p.line));
+				}
+				p = nx;
+				if (charClass(this.charAt(p), big) !== cls) {
+					break;
+				}
+			}
+		}
+		let moved = cmp(p, start) !== 0;
+		while (charClass(this.charAt(p), big) === 0) {
+			if (moved && this.isEmptyLine(p)) {
+				break;
+			}
+			const nx = this.nextChar(p);
+			if (!nx) {
+				return pos(p.line, this.len(p.line));
+			}
+			p = nx;
+			moved = true;
+		}
+		return p;
+	}
+
+	private wordBackward(start: VimPos, big: boolean): VimPos {
+		const first = this.prevChar(start);
+		if (!first) {
+			return start;
+		}
+		let p: VimPos = first;
+		while (charClass(this.charAt(p), big) === 0 && !this.isEmptyLine(p)) {
+			const pv = this.prevChar(p);
+			if (!pv) {
+				return p;
+			}
+			p = pv;
+		}
+		if (this.isEmptyLine(p)) {
+			return p;
+		}
+		const cls = charClass(this.charAt(p), big);
+		for (; ;) {
+			if (p.col === 0) {
+				return p;
+			}
+			const pv = this.prevChar(p)!;
+			if (charClass(this.charAt(pv), big) !== cls) {
+				return p;
+			}
+			p = pv;
+		}
+	}
+
+	/** End of the n-th word; `stayIfAtEnd` is the `cw` rule (count the current word). */
+	private wordEnd(start: VimPos, big: boolean, n: number, stayIfAtEnd: boolean): VimPos {
+		let p = start;
+		for (let c = 0; c < n; c++) {
+			if (!(stayIfAtEnd && c === 0 && charClass(this.charAt(p), big) !== 0)) {
+				const nx = this.nextChar(p);
+				if (!nx) {
+					return p;
+				}
+				p = nx;
+				while (charClass(this.charAt(p), big) === 0) {
+					const nn = this.nextChar(p);
+					if (!nn) {
+						return this.clampNormal(p);
+					}
+					p = nn;
+				}
+			}
+			const cls = charClass(this.charAt(p), big);
+			for (; ;) {
+				const nx = this.nextChar(p);
+				if (!nx || nx.line !== p.line || charClass(this.charAt(nx), big) !== cls) {
+					break;
+				}
+				p = nx;
+			}
+		}
+		return p;
+	}
+
+	private wordEndBackward(start: VimPos, big: boolean, n: number): VimPos {
+		let p = start;
+		for (let c = 0; c < n; c++) {
+			const cls = charClass(this.charAt(p), big);
+			// leave the current word
+			while (charClass(this.charAt(p), big) === cls && cls !== 0) {
+				const pv = this.prevChar(p);
+				if (!pv) {
+					return p;
+				}
+				p = pv;
+			}
+			while (charClass(this.charAt(p), big) === 0 && !this.isEmptyLine(p)) {
+				const pv = this.prevChar(p);
+				if (!pv) {
+					return p;
+				}
+				p = pv;
+			}
+		}
+		return p;
+	}
+
+	private findInLine(cur: VimPos, key: string, ch: string, n: number, repeat: boolean): MotionResult | undefined {
+		const text = this.host.lineText(cur.line);
+		const forward = key === 'f' || key === 't';
+		const till = key === 't' || key === 'T';
+		let idx = cur.col;
+		for (let c = 0; c < n; c++) {
+			let from = forward ? idx + 1 : idx - 1;
+			// A repeated `t` must not stick in front of the char it already reached.
+			if (c === 0 && till && repeat) {
+				from = forward ? idx + 2 : idx - 2;
+			}
+			idx = forward ? text.indexOf(ch, from) : (from < 0 ? -1 : text.lastIndexOf(ch, from));
+			if (idx < 0) {
+				return undefined;
+			}
+		}
+		const col = till ? (forward ? idx - 1 : idx + 1) : idx;
+		return { pos: pos(cur.line, col), inclusive: forward };
+	}
+
+	private matchBracket(cur: VimPos): MotionResult | undefined {
+		const text = this.host.lineText(cur.line);
+		let col = cur.col;
+		while (col < text.length && !'()[]{}'.includes(text[col])) {
+			col++;
+		}
+		if (col >= text.length) {
+			return undefined;
+		}
+		const ch = text[col];
+		const [open, close] = BRACKETS[ch];
+		const found = ch === open ? this.scanBracket(pos(cur.line, col), open, close, true) : this.scanBracket(pos(cur.line, col), open, close, false);
+		return found ? { pos: found, inclusive: true } : undefined;
+	}
+
+	/** From a bracket at `from`, find its partner, walking lines lazily. */
+	private scanBracket(from: VimPos, open: string, close: string, forward: boolean): VimPos | undefined {
+		let depth = 0;
+		const last = this.lastLine();
+		for (let line = from.line; forward ? line <= last : line >= 0; line += forward ? 1 : -1) {
+			const text = this.host.lineText(line);
+			let col = line === from.line ? from.col : (forward ? 0 : text.length - 1);
+			for (; forward ? col < text.length : col >= 0; col += forward ? 1 : -1) {
+				const c = text[col];
+				if (c === (forward ? open : close)) {
+					depth++;
+				} else if (c === (forward ? close : open)) {
+					depth--;
+					if (depth === 0) {
+						return pos(line, col);
+					}
+				}
+			}
+		}
+		return undefined;
+	}
+
+	/** Unmatched `open` before `cur` (or at it). */
+	private enclosingOpen(cur: VimPos, open: string, close: string): VimPos | undefined {
+		if (this.charAt(cur) === open) {
+			return cur;
+		}
+		let depth = 0;
+		let p: VimPos | undefined = this.charAt(cur) === close ? this.prevChar(cur) : cur;
+		while (p) {
+			const c = this.charAt(p);
+			if (c === close) {
+				depth++;
+			} else if (c === open) {
+				if (depth === 0) {
+					return p;
+				}
+				depth--;
+			}
+			p = this.prevChar(p);
+		}
+		return undefined;
+	}
+
+	// ---- text objects -------------------------------------------------------
+
+	private textObject(kind: string, ch: string, count: number, cur: VimPos): Range | undefined {
+		if (ch === 'w' || ch === 'W') {
+			return this.wordObject(kind === 'a', ch === 'W', count, cur);
+		}
+		if (QUOTES.has(ch)) {
+			return this.quoteObject(kind === 'a', ch, cur);
+		}
+		const pair = BRACKETS[ch];
+		if (pair) {
+			let p: VimPos | undefined = cur;
+			let openPos: VimPos | undefined;
+			for (let c = 0; c < count && p; c++) {
+				openPos = this.enclosingOpen(p, pair[0], pair[1]);
+				p = openPos ? this.prevChar(openPos) : undefined;
+			}
+			if (!openPos) {
+				return undefined;
+			}
+			const closePos = this.scanBracket(openPos, pair[0], pair[1], true);
+			if (!closePos) {
+				return undefined;
+			}
+			if (kind === 'a') {
+				return { start: openPos, end: pos(closePos.line, closePos.col + 1), linewise: false };
+			}
+			let start = pos(openPos.line, openPos.col + 1);
+			let end = closePos;
+			// `{` at line end and `}` alone on its line: the inner lines, linewise.
+			if (start.col === this.len(start.line) && start.line < end.line && this.firstNonBlank(end.line) === end.col) {
+				if (end.line - start.line < 2) {
+					return { start: pos(start.line + 1, 0), end: pos(start.line + 1, 0), linewise: false };
+				}
+				return { start: pos(start.line + 1, 0), end: pos(end.line - 1, this.len(end.line - 1)), linewise: true };
+			}
+			if (cmp(start, end) > 0) {
+				start = end;
+			}
+			return { start, end, linewise: false };
+		}
+		return undefined;
+	}
+
+	/** `iw` / `aw` with a count: `2iw` is a word and the blanks after it, `2aw` two words with their blanks (within the line). */
+	private wordObject(around: boolean, big: boolean, count: number, cur: VimPos): Range | undefined {
+		const text = this.host.lineText(cur.line);
+		if (text.length === 0) {
+			return undefined;
+		}
+		const col = Math.min(cur.col, text.length - 1);
+		const cls = charClass(text[col], big);
+		let s = col;
+		let e = col + 1;
+		while (s > 0 && charClass(text[s - 1], big) === cls) {
+			s--;
+		}
+		while (e < text.length && charClass(text[e], big) === cls) {
+			e++;
+		}
+		if (around) {
+			if (cls === 0) {
+				// on blanks: blanks plus the following word
+				if (e < text.length) {
+					const c2 = charClass(text[e], big);
+					while (e < text.length && charClass(text[e], big) === c2) {
+						e++;
+					}
+				}
+			} else {
+				const e0 = e;
+				while (e < text.length && charClass(text[e], big) === 0) {
+					e++;
+				}
+				if (e === e0) {
+					while (s > 0 && charClass(text[s - 1], big) === 0) {
+						s--;
+					}
+				}
+			}
+		}
+		const run = (from: number): number => {
+			const c = charClass(text[from], big);
+			let to = from;
+			while (to < text.length && charClass(text[to], big) === c) {
+				to++;
+			}
+			return to;
+		};
+		for (let c = 1; c < count && e < text.length; c++) {
+			e = run(e);
+			if (around && e < text.length && charClass(text[e - 1], big) !== 0) {
+				// a word: take the blanks after it too
+				if (charClass(text[e], big) === 0) {
+					e = run(e);
+				}
+			} else if (around && e < text.length) {
+				// blanks: and the word after them
+				e = run(e);
+			}
+		}
+		return { start: pos(cur.line, s), end: pos(cur.line, e), linewise: false };
+	}
+
+	private quoteObject(around: boolean, q: string, cur: VimPos): Range | undefined {
+		const text = this.host.lineText(cur.line);
+		const quotes: number[] = [];
+		for (let c = 0; c < text.length; c++) {
+			if (text[c] === '\\') {
+				c++;
+				continue;
+			}
+			if (text[c] === q) {
+				quotes.push(c);
+			}
+		}
+		let pair: [number, number] | undefined;
+		for (let j = 0; j + 1 < quotes.length; j += 2) {
+			if (quotes[j] <= cur.col && cur.col <= quotes[j + 1]) {
+				pair = [quotes[j], quotes[j + 1]];
+				break;
+			}
+		}
+		if (!pair) {
+			for (let j = 0; j + 1 < quotes.length; j += 2) {
+				if (quotes[j] > cur.col) {
+					pair = [quotes[j], quotes[j + 1]];
+					break;
+				}
+			}
+		}
+		if (!pair) {
+			return undefined;
+		}
+		if (!around) {
+			return { start: pos(cur.line, pair[0] + 1), end: pos(cur.line, pair[1]), linewise: false };
+		}
+		let e = pair[1] + 1;
+		let s = pair[0];
+		if (e < text.length && /\s/.test(text[e])) {
+			while (e < text.length && /\s/.test(text[e])) {
+				e++;
+			}
+		} else {
+			while (s > 0 && /\s/.test(text[s - 1])) {
+				s--;
+			}
+		}
+		return { start: pos(cur.line, s), end: pos(cur.line, e), linewise: false };
+	}
+
+
+	// ---- visual mode --------------------------------------------------------
+
+	private visualRange(): Range {
+		const [a, b] = cmp(this.visualAnchor, this.visualHead) <= 0 ? [this.visualAnchor, this.visualHead] : [this.visualHead, this.visualAnchor];
+		if (this._mode === 'visualLine') {
+			return { start: pos(a.line, 0), end: pos(b.line, this.len(b.line)), linewise: true };
+		}
+		const end = b.col < this.len(b.line) ? pos(b.line, b.col + 1) : (this.nextChar(b) ?? b);
+		return { start: a, end, linewise: false };
+	}
+
+	private renderVisual(): void {
+		const r = this.visualRange();
+		const backwards = cmp(this.visualHead, this.visualAnchor) < 0;
+		this.visualMarks = { start: r.start.line, end: r.end.line };
+		this.host.setSelection(r.start, r.end, backwards);
+	}
+
+	// ---- the `:` / `/` prompt ----------------------------------------------
+
+	private cmdCmdline(kind: string): void {
+		if ((kind !== ':' && kind !== '/' && kind !== '?') || this.textObjectKind || (kind === ':' && this.operator)) {
+			this.invalid();
+		}
+		if (kind === ':') {
+			let text = '';
+			if (this.isVisual()) {
+				// as in Vim, `:` from visual mode is for the selected lines
+				this._mode = 'normal';
+				this.setNormalCursor(this.visualHead);
+				text = '\'<,\'>';
+			}
+			this.resetGrammar();
+			this.cmdline = { kind, text };
+			return;
+		}
+		// The operator, count and register wait for the search (`d/foo<CR>`).
+		this.cmdline = { kind, text: '' };
+	}
+
+	/**
+	 * A key typed into the open prompt: a character, or `<Esc>`, `<CR>`, `<BS>`,
+	 * `<Tab>` (completes an ex command name, again for the next match).
+	 */
+	cmdlineKey(key: string): void {
+		const cl = this.cmdline;
+		if (!cl) {
+			return;
+		}
+		try {
+			if (key === '<Esc>') {
+				this.escape();
+				return;
+			}
+			if (key === '<Tab>') {
+				if (cl.kind === ':') {
+					this.completeCmdline(cl);
+				}
+				return;
+			}
+			cl.completion = undefined;
+			if (key === '<BS>') {
+				if (!cl.text) {
+					this.cmdline = undefined;
+					this.resetGrammar();
+				} else {
+					cl.text = Array.from(cl.text).slice(0, -1).join('');
+				}
+				return;
+			}
+			if (key === '<CR>') {
+				this.cmdline = undefined;
+				if (cl.kind === ':') {
+					this.execute('devhubVim.ex', { command: cl.text.trim() });
+				} else {
+					this.execute('devhubVim.search', { pattern: cl.text, backwards: cl.kind === '?' });
+				}
+				return;
+			}
+			if (Array.from(key).length === 1) {
+				cl.text += key;
+			}
+		} catch (err) {
+			this.recover(err);
+		}
+	}
+
+	private completeCmdline(cl: NonNullable<VimEngine['cmdline']>): void {
+		const c = cl.completion;
+		if (c) {
+			c.index = (c.index + 1) % c.matches.length;
+			cl.text = c.base + c.matches[c.index];
+			return;
+		}
+		const m = /^([^A-Za-z]*)([A-Za-z][A-Za-z0-9]*)?$/.exec(cl.text);
+		if (!m) {
+			return;
+		}
+		const matches = completeExName(m[2] ?? '', this.shared.exNames());
+		if (matches.length) {
+			cl.completion = { base: m[1], matches, index: 0 };
+			cl.text = m[1] + matches[0];
+		}
+	}
+
+	private cmdSearch(text: string, backwards: boolean): void {
+		const op = this.operator;
+		const pattern = text || this.shared.lastSearch?.pattern;
+		if (!pattern) {
+			if (op) {
+				this.invalid();
+			}
+			this.complete(undefined);
+			return;
+		}
+		this.shared.lastSearch = { pattern, backwards };
+		const cur = this.cursor();
+		const res = this.searchMotion(pattern, backwards, cur, 1);
+		if (!res) {
+			if (op) {
+				this.invalid(this.message);
+			}
+			this.complete(undefined);
+			return;
+		}
+		if (op) {
+			const change = op === 'y' ? undefined : this.snapshot();
+			this.applyOperator(op, this.register, this.motionRange(cur, res), cur, change);
+			this.complete(op === 'c' ? undefined : change);
+			return;
+		}
+		if (this.isVisual()) {
+			this.visualHead = res.pos;
+			this.renderVisual();
+		} else {
+			this.setNormalCursor(res.pos);
+		}
+		this.complete(undefined);
+	}
+
+	/**
+	 * `:[range]name[!] [args]` (common/vimEx.ts). A bare range moves to its last
+	 * line. With a range the lines are selected while the commands run (so a
+	 * command that works on the selection, such as sorting, gets them), then the
+	 * caret goes back to the range's first line.
+	 */
+	private runEx(line: string): void {
+		if (!line.trim()) {
+			return;
+		}
+		const p = parseExLine(line);
+		const cur = this.cursor();
+		let range: { start: number; end: number } | undefined;
+		if (p.range) {
+			const ctx = { cursorLine: cur.line, lastLine: this.lastLine(), visual: this.visualMarks };
+			const a = resolveExAddress(p.range[0], ctx);
+			const b = resolveExAddress(p.range[1], ctx);
+			if (a === undefined || b === undefined) {
+				this.message = `Invalid range: ${line}`;
+				return;
+			}
+			range = a <= b ? { start: a, end: b } : { start: b, end: a };
+		}
+		if (!p.name) {
+			if (range) {
+				this.setNormalCursor(pos(range.end, this.firstNonBlank(range.end)));
+			} else {
+				this.message = `Not an editor command: ${line}`;
+			}
+			return;
+		}
+		const found = this.shared.lookupEx(p.name);
+		if ('error' in found) {
+			this.message = found.error;
+			return;
+		}
+		const steps = expandExEntry(found.entry, {
+			args: p.args,
+			bang: p.bang,
+			range: range && { start: range.start + 1, end: range.end + 1 },
+			cursorLine: cur.line + 1,
+		});
+		const r = range;
+		if (r) {
+			this.host.setSelection(pos(r.start, 0), pos(r.end, this.len(r.end)), false);
+		}
+		this.runSteps(steps, r ? () => {
+			if (this._mode === 'normal') {
+				const l = Math.min(r.start, this.lastLine());
+				this.setNormalCursor(pos(l, this.firstNonBlank(l)));
+			}
+		} : undefined);
+	}
+
+	/** Run steps in order, each awaited; engine commands run in the engine (and are recorded). */
+	private runSteps(steps: readonly ExStep[], after?: () => void): void {
+		void (async () => {
+			try {
+				for (const s of steps) {
+					if (!this.execute(s.command, s.args)) {
+						await this.host.executeCommand(s.command, s.args);
+					}
+				}
+			} catch (err) {
+				this.message = String(err instanceof Error ? err.message : err);
+			} finally {
+				try {
+					after?.();
+				} catch {
+					// the editor went away while the commands ran
+				}
+				this.host.refresh();
+			}
+		})();
+	}
+}
+
+function toggleCase(s: string): string {
+	let out = '';
+	for (const ch of s) {
+		const up = ch.toUpperCase();
+		out += ch === up ? ch.toLowerCase() : up;
+	}
+	return out;
+}
diff --git a/src/vs/workbench/contrib/devhubVim/common/vimEx.ts b/src/vs/workbench/contrib/devhubVim/common/vimEx.ts
