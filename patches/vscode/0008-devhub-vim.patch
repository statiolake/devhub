+	applyEdits(edits: readonly VimEdit[]): void;
+	/** Brackets one Vim change so that `u` undoes it as a single step. */
+	beginChange(): void;
+	endChange(): void;
+	undo(): void;
+	redo(): void;
+	indentUnit(): string;
+	tabSize(): number;
+	visibleLineCount(): number;
+	setClipboard(text: string): void;
+	/** Last known system clipboard text; `prefetchClipboard` refreshes it. */
+	getClipboard(): string;
+	prefetchClipboard(): void;
+	/** Start of the next match of `pattern` from `from` (wrapping), or undefined. */
+	find(pattern: string, from: VimPos, backwards: boolean): VimPos | undefined;
+	/** Ex commands the engine does not know itself (`w`, `q`, ...). */
+	exCommand(command: string): boolean;
+}
+
+export interface VimRegister {
+	readonly text: string;
+	readonly linewise: boolean;
+}
