+	/** End the current undo step and start a new one (the insert goes on). */
+	private breakUndo(): void {
+		if (this.changeOpen && this.changeBatch === 0) {
+			this.closeChange();
+			this.openChange();
+		}
+	}
+
+	private repeatLastChange(count: number | undefined): void {
