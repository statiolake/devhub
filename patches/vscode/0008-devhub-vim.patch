+				this.recordChange(change());
+				return { status: 'done' };
+			}
+			case 'r': {
+				if (k.length < i + 2) {
+					return { status: 'incomplete' };
+				}
+				const ch = k[i + 1];
+				if (ch.length !== 1 || cur.col + n > this.len(cur.line)) {
+					return { status: 'invalid' };
+				}
+				this.edit([{ start: cur, end: pos(cur.line, cur.col + n), text: ch.repeat(n) }]);
+				this.closeChange();
+				this.setNormalCursor(pos(cur.line, cur.col + n - 1));
+				this.recordChange(change());
+				return { status: 'done' };
+			}
+			case '~': {
+				const text = this.host.lineText(cur.line);
+				const end = Math.min(text.length, cur.col + n);
+				if (end > cur.col) {
+					this.edit([{ start: cur, end: pos(cur.line, end), text: toggleCase(text.slice(cur.col, end)) }]);
+					this.closeChange();
+					this.setNormalCursor(pos(cur.line, end));
+					this.recordChange(change());
+				}
+				return { status: 'done' };
+			}
+			case 'J': {
+				this.join(cur.line, Math.max(2, n));
+				this.recordChange(change());
+				return { status: 'done' };
+			}
+			case 'u': {
+				for (let c = 0; c < n; c++) {
+					this.host.undo();
+				}
+				return { status: 'done' };
+			}
+			case '<C-r>': {
+				for (let c = 0; c < n; c++) {
+					this.host.redo();
+				}
+				return { status: 'done' };
+			}
+			case '.': {
+				this.repeatLastChange(count);
+				return { status: 'done' };
+			}
+			case 'v': case 'V': {
+				this._mode = key === 'v' ? 'visual' : 'visualLine';
+				this.visualAnchor = cur;
+				this.visualHead = cur;
+				this.renderVisual();
+				return { status: 'done' };
+			}
+			case ':': case '/': case '?': {
+				this.cmdline = { kind: key, text: '' };
+				return { status: 'done' };
+			}
+			case 'g': {
+				if (k.length < i + 2) {
+					return { status: 'incomplete' };
+				}
+				return { status: 'invalid' };
+			}
+		}
+		return { status: 'invalid' };
+	}
+
+	private finishChangeRecord(change: LastChange, op: string): void {
+		if (op === 'c') {
+			// Recorded on leaving insert mode, with the typed text.
+			if (this.pendingChange) {
+				this.pendingChange = change;
+			}
+			return;
+		}
+		this.recordChange(change);
+	}
+
+	private repeatLastChange(count: number | undefined): void {
+		const last = this.lastChange;
+		if (!last) {
+			return;
+		}
+		this.replaying = true;
+		try {
+			const keys: string[] = [];
+			if (last.register) {
+				keys.push('"', last.register);
+			}
+			const c = count ?? last.count;
+			if (c !== undefined) {
+				keys.push(...String(c));
+			}
+			keys.push(...last.keys);
+			this.keys = [];
+			for (const key of keys) {
+				this.handleKey(key);
+			}
+			if (this._mode === 'insert') {
+				if (last.insertText) {
+					const at = this.host.getCursor();
+					this.edit([{ start: at, end: at, text: last.insertText }]);
+					this.host.setCursor(this.endOfInsertedText(at, last.insertText));
+				}
+				this.exitInsert();
+			}
+		} finally {
+			this.replaying = false;
+		}
+	}
+
+	private endOfInsertedText(at: VimPos, text: string): VimPos {
+		const lines = text.split('\n');
+		return lines.length === 1 ? pos(at.line, at.col + text.length) : pos(at.line + lines.length - 1, lines[lines.length - 1].length);
+	}
+
+	private enterInsert(at: VimPos, count: number, change: LastChange | undefined): void {
+		this._mode = 'insert';
+		this.host.setCursor(at);
+		this.insertStart = at;
+		this.insertCount = count;
+		this.pendingChange = change;
+	}
+
+	private exitInsert(): void {
+		const start = this.insertStart;
+		let cur = this.host.getCursor();
+		let typed = '';
+		if (start && cmp(cur, start) > 0) {
+			typed = this.getText(start, cur);
+			if (this.insertCount > 1 && typed) {
+				const more = typed.repeat(this.insertCount - 1);
+				this.edit([{ start: cur, end: cur, text: more }]);
+				cur = this.endOfInsertedText(cur, more);
+			}
+		}
+		this.closeChange();
+		if (this.pendingChange) {
+			this.recordChange({ ...this.pendingChange, insertText: typed });
+		}
+		this.pendingChange = undefined;
+		this.insertStart = undefined;
+		this._mode = 'normal';
+		this.setNormalCursor(pos(cur.line, cur.col - 1));
+	}
+
+	// ---- operators ----------------------------------------------------------
+
+	private runOperator(op: string, register: string | undefined, count: number | undefined, rest: string[], cur: VimPos): Parse {
+		if (rest.length === 0) {
+			return { status: 'incomplete' };
+		}
+		const n = count ?? 1;
+		let range: Range | undefined;
+		if (rest[0] === op || (op === 'c' && rest[0] === 'c')) {
+			// dd, cc, yy, >>, <<: count lines.
+			if (rest.length > 1) {
+				return { status: 'invalid' };
+			}
+			const endLine = Math.min(this.lastLine(), cur.line + n - 1);
+			range = { start: pos(cur.line, 0), end: pos(endLine, this.len(endLine)), linewise: true };
+		} else if ((rest[0] === '/' || rest[0] === '?') && rest.length === 1) {
+			// d/pattern<CR>: the prompt finishes the command.
+			this.cmdline = { kind: rest[0], text: '', operator: { op, register, count } };
+			return { status: 'done' };
+		} else if (rest[0] === 'i' || rest[0] === 'a') {
+			if (rest.length < 2) {
+				return { status: 'incomplete' };
+			}
+			range = this.textObject(rest[0], rest[1], n, cur);
+			if (!range) {
+				return { status: 'invalid' };
+			}
+		} else {
+			// `cw` on a word behaves like `ce` (Vim's documented exception), and
+			// on the last char of a word changes just that char.
+			if (op === 'c' && (rest[0] === 'w' || rest[0] === 'W') && charClass(this.charAt(cur), false) !== 0) {
+				if (rest.length > 1) {
+					return { status: 'invalid' };
+				}
+				const e = this.wordEnd(cur, rest[0] === 'W', n, true);
+				range = { start: cur, end: pos(e.line, Math.min(e.col + 1, this.len(e.line))), linewise: false };
+			} else {
+				const m = this.parseMotion(rest, 0, count, true, cur);
+				if (m.status === 'incomplete') {
+					return m;
+				}
+				if (m.status !== 'ok' || !m.result) {
+					return { status: 'invalid' };
+				}
+				range = this.motionRange(cur, m.result);
+			}
+		}
+		this.applyOperator(op, register, range, cur);
+		return { status: 'done' };
+	}
+
+	private motionRange(cur: VimPos, m: MotionResult): Range {
+		if (m.linewise) {
+			const s = Math.min(cur.line, m.pos.line);
+			const e = Math.max(cur.line, m.pos.line);
+			return { start: pos(s, 0), end: pos(e, this.len(e)), linewise: true };
+		}
+		let [a, b] = cmp(cur, m.pos) <= 0 ? [cur, m.pos] : [m.pos, cur];
+		if (m.inclusive) {
+			b = b.col < this.len(b.line) ? pos(b.line, b.col + 1) : (this.nextChar(b) ?? b);
+		} else if (b.col === 0 && b.line > a.line && cmp(m.pos, cur) > 0) {
+			// Exclusive motion ending at column 0: stop at the previous line's end
+			// and, if it started before the first non-blank, go linewise.
+			b = pos(b.line - 1, this.len(b.line - 1));
+			if (a.col <= this.firstNonBlank(a.line)) {
+				return { start: pos(a.line, 0), end: b, linewise: true };
+			}
+		}
+		return { start: a, end: b, linewise: false };
+	}
+
+	private applyOperator(op: string, register: string | undefined, range: Range, cur: VimPos): void {
+		const { start, end, linewise } = range;
+		if (op === '>' || op === '<') {
+			this.shift(start.line, end.line, op === '>');
+			this.closeChange();
+			return;
+		}
+		if (linewise) {
+			const text = this.getText(pos(start.line, 0), pos(end.line, this.len(end.line)));
+			if (op === 'y') {
+				this.writeRegister(register, text, true, true);
+				if (start.line < cur.line) {
+					this.setNormalCursor(pos(start.line, cur.col));
+				}
+				return;
+			}
+			this.writeRegister(register, text, true, false);
+			if (op === 'd') {
+				let s: VimPos;
+				let e: VimPos;
+				if (end.line < this.lastLine()) {
+					s = pos(start.line, 0);
+					e = pos(end.line + 1, 0);
+				} else if (start.line > 0) {
+					s = pos(start.line - 1, this.len(start.line - 1));
+					e = pos(end.line, this.len(end.line));
+				} else {
+					s = pos(0, 0);
+					e = pos(end.line, this.len(end.line));
+				}
+				this.edit([{ start: s, end: e, text: '' }]);
+				this.closeChange();
+				const line = Math.min(start.line, this.lastLine());
+				this.setNormalCursor(pos(line, this.firstNonBlank(line)));
+				return;
+			}
+			// c: keep one line, with the first line's indent.
+			const indent = /^\s*/.exec(this.host.lineText(start.line))![0];
+			this.edit([{ start: pos(start.line, 0), end: pos(end.line, this.len(end.line)), text: indent }]);
+			this.enterInsert(pos(start.line, indent.length), 1, undefined);
+			this.pendingChange = { register: undefined, count: undefined, keys: [] };
+			return;
+		}
+		if (cmp(start, end) >= 0) {
+			if (op === 'c') {
+				this.openChange();
+				this.enterInsert(start, 1, undefined);
+				this.pendingChange = { register: undefined, count: undefined, keys: [] };
+			}
+			return;
+		}
+		const text = this.getText(start, end);
+		this.writeRegister(register, text, false, op === 'y');
+		if (op === 'y') {
+			this.setNormalCursor(start);
+			return;
+		}
+		this.edit([{ start, end, text: '' }]);
+		if (op === 'd') {
+			this.closeChange();
+			this.setNormalCursor(start);
+			return;
+		}
+		this.enterInsert(start, 1, undefined);
+		this.pendingChange = { register: undefined, count: undefined, keys: [] };
+	}
+
+	private shift(from: number, to: number, right: boolean): void {
+		const unit = this.host.indentUnit();
+		const tab = this.host.tabSize();
+		const edits: VimEdit[] = [];
+		for (let l = from; l <= to; l++) {
+			const text = this.host.lineText(l);
+			if (right) {
+				if (text.length) {
+					edits.push({ start: pos(l, 0), end: pos(l, 0), text: unit });
+				}
+			} else {
+				let remove = 0;
+				if (text[0] === '\t') {
+					remove = 1;
+				} else {
+					while (remove < tab && text[remove] === ' ') {
+						remove++;
+					}
+				}
+				if (remove) {
+					edits.push({ start: pos(l, 0), end: pos(l, remove), text: '' });
+				}
+			}
+		}
+		this.edit(edits);
+		this.setNormalCursor(pos(from, this.firstNonBlank(from)));
+	}
+
+	private join(line: number, count: number): void {
+		const last = Math.min(this.lastLine(), line + count - 1);
+		if (last === line) {
+			return;
+		}
+		const edits: VimEdit[] = [];
+		let joinedLength = this.len(line);
+		let cursorCol = 0;
+		for (let l = line; l < last; l++) {
+			const cur = this.host.lineText(l);
+			const next = this.host.lineText(l + 1);
+			const fnb = this.firstNonBlank(l + 1);
+			const rest = next.slice(fnb);
+			const curJoined = l === line ? cur : 'x'; // only "ends with blank" matters below
+			const sep = rest === '' || rest.startsWith(')') || /\s$/.test(curJoined) || (l === line && cur === '') ? '' : ' ';
+			edits.push({ start: pos(l, cur.length), end: pos(l + 1, fnb), text: sep });
+			cursorCol = joinedLength;
+			joinedLength += sep.length + rest.length;
+		}
+		this.edit(edits);
+		this.closeChange();
+		this.setNormalCursor(pos(line, cursorCol));
+	}
+
+	private put(register: string | undefined, count: number, before: boolean, cur: VimPos): void {
+		const reg = this.readRegister(register);
+		if (!reg) {
+			return;
+		}
+		if (reg.linewise) {
+			const block = new Array(count).fill(reg.text).join('\n');
+			if (before) {
+				this.edit([{ start: pos(cur.line, 0), end: pos(cur.line, 0), text: block + '\n' }]);
+				this.closeChange();
+				this.setNormalCursor(pos(cur.line, this.firstNonBlank(cur.line)));
+			} else {
+				const eol = pos(cur.line, this.len(cur.line));
+				this.edit([{ start: eol, end: eol, text: '\n' + block }]);
+				this.closeChange();
+				this.setNormalCursor(pos(cur.line + 1, this.firstNonBlank(cur.line + 1)));
+			}
+			return;
+		}
+		const text = reg.text.repeat(count);
+		const at = before || this.len(cur.line) === 0 ? cur : pos(cur.line, cur.col + 1);
+		this.edit([{ start: at, end: at, text }]);
+		this.closeChange();
+		const end = this.endOfInsertedText(at, text);
+		this.setNormalCursor(pos(end.line, end.col - 1));
+	}
+
+	// ---- motions ------------------------------------------------------------
+
+	private parseMotion(k: string[], i: number, count: number | undefined, forOperator: boolean, cur: VimPos):
+		{ status: 'incomplete' } | { status: 'invalid' } | { status: 'none' } | { status: 'ok'; result: MotionResult | undefined } {
+		const key = k[i];
+		if (key === undefined) {
+			return { status: 'incomplete' };
+		}
+		const n = count ?? 1;
+		if (CHAR_ARG_MOTIONS.has(key)) {
+			if (k.length < i + 2) {
+				return { status: 'incomplete' };
+			}
+			if (k.length > i + 2) {
+				return { status: 'invalid' };
+			}
+			const ch = k[i + 1];
+			if (ch.length !== 1) {
+				return { status: 'invalid' };
+			}
+			this.shared.lastFind = { key, char: ch };
+			return { status: 'ok', result: this.findInLine(cur, key, ch, n, false) };
+		}
+		if (key === 'g') {
+			if (k.length < i + 2) {
+				return { status: 'incomplete' };
+			}
+			if (k.length > i + 2) {
+				return { status: 'invalid' };
+			}
+			const k2 = k[i + 1];
+			if (k2 === 'g') {
+				const line = Math.min(this.lastLine(), (count ?? 1) - 1);
+				return { status: 'ok', result: { pos: pos(line, this.firstNonBlank(line)), linewise: true } };
+			}
+			if (k2 === 'e' || k2 === 'E') {
+				return { status: 'ok', result: { pos: this.wordEndBackward(cur, k2 === 'E', n), inclusive: true } };
+			}
+			return { status: 'none' };
+		}
+		if (!SIMPLE_MOTIONS.has(key)) {
+			return { status: 'none' };
+		}
+		if (k.length > i + 1) {
+			return { status: 'invalid' };
+		}
+		const last = this.lastLine();
+		switch (key) {
+			case 'h': case '<BS>':
+				return { status: 'ok', result: { pos: pos(cur.line, Math.max(0, cur.col - n)) } };
+			case 'l': case ' ': {
+				const max = forOperator ? this.len(cur.line) : Math.max(0, this.len(cur.line) - 1);
+				return { status: 'ok', result: { pos: pos(cur.line, Math.min(max, cur.col + n)) } };
+			}
+			case 'j': case 'k': case '<C-d>': case '<C-u>': {
+				const step = key === '<C-d>' || key === '<C-u>' ? Math.max(1, Math.floor(this.host.visibleLineCount() / 2)) * (count ?? 1) : n;
+				const down = key === 'j' || key === '<C-d>';
+				const line = Math.max(0, Math.min(last, cur.line + (down ? step : -step)));
+				if (line === cur.line && forOperator) {
+					return { status: 'ok', result: undefined };
+				}
+				return { status: 'ok', result: { pos: pos(line, this.desiredColFor(line)), linewise: true, vertical: true } };
+			}
+			case '+': case '<CR>': case '-': case '_': {
+				const delta = key === '-' ? -n : key === '_' ? n - 1 : n;
+				const line = Math.max(0, Math.min(last, cur.line + delta));
+				return { status: 'ok', result: { pos: pos(line, this.firstNonBlank(line)), linewise: true } };
+			}
+			case '0':
+				return { status: 'ok', result: { pos: pos(cur.line, 0) } };
+			case '^':
+				return { status: 'ok', result: { pos: pos(cur.line, this.firstNonBlank(cur.line)) } };
+			case '$': {
+				const line = Math.min(last, cur.line + n - 1);
+				return { status: 'ok', result: { pos: pos(line, Math.max(0, this.len(line) - 1)), inclusive: true } };
+			}
+			case 'G': {
+				const line = count === undefined ? last : Math.max(0, Math.min(last, count - 1));
+				return { status: 'ok', result: { pos: pos(line, this.firstNonBlank(line)), linewise: true } };
+			}
+			case 'w': case 'W': {
+				let p = cur;
+				for (let c = 0; c < n; c++) {
+					p = this.wordForward(p, key === 'W');
+				}
+				return { status: 'ok', result: { pos: p } };
+			}
+			case 'b': case 'B': {
+				let p = cur;
+				for (let c = 0; c < n; c++) {
+					p = this.wordBackward(p, key === 'B');
+				}
+				return { status: 'ok', result: { pos: p } };
+			}
+			case 'e': case 'E':
+				return { status: 'ok', result: { pos: this.wordEnd(cur, key === 'E', n, false), inclusive: true } };
+			case ';': case ',': {
+				const lf = this.shared.lastFind;
+				if (!lf) {
+					return { status: 'ok', result: undefined };
+				}
+				let k2 = lf.key;
+				if (key === ',') {
+					k2 = k2 === 'f' ? 'F' : k2 === 'F' ? 'f' : k2 === 't' ? 'T' : 't';
+				}
+				return { status: 'ok', result: this.findInLine(cur, k2, lf.char, n, true) };
+			}
+			case '%':
+				return { status: 'ok', result: this.matchBracket(cur) };
+			case 'n': case 'N': {
+				const ls = this.shared.lastSearch;
+				if (!ls) {
+					return { status: 'ok', result: undefined };
+				}
+				const back = key === 'N' ? !ls.backwards : ls.backwards;
+				return { status: 'ok', result: this.searchMotion(ls.pattern, back, cur, n) };
+			}
+			case '*': case '#': {
+				const word = this.wordUnderCursor(cur);
+				if (!word) {
+					return { status: 'ok', result: undefined };
+				}
+				const pattern = isWordChar(word[0]) ? `\\b${escapeRegExp(word)}\\b` : escapeRegExp(word);
+				this.shared.lastSearch = { pattern, backwards: key === '#' };
+				return { status: 'ok', result: this.searchMotion(pattern, key === '#', cur, n) };
+			}
+		}
+		return { status: 'none' };
+	}
+
+	private desiredColFor(line: number): number {
+		return Math.min(this.desiredCol, Math.max(0, this.len(line) - 1));
+	}
+
+	private searchMotion(pattern: string, backwards: boolean, cur: VimPos, n: number): MotionResult | undefined {
+		let p = cur;
+		for (let c = 0; c < n; c++) {
+			const from = backwards ? p : (p.col < this.len(p.line) ? pos(p.line, p.col + 1) : p);
+			const found = this.host.find(pattern, from, backwards);
+			if (!found) {
+				this.message = `Pattern not found: ${pattern}`;
+				return undefined;
+			}
+			p = found;
+		}
+		return { pos: p };
+	}
+
+	private wordUnderCursor(cur: VimPos): string | undefined {
+		const text = this.host.lineText(cur.line);
+		let c = cur.col;
+		while (c < text.length && !isWordChar(text[c])) {
+			c++;
+		}
+		if (c >= text.length) {
+			return undefined;
+		}
+		let s = c;
+		let e = c;
+		while (s > 0 && isWordChar(text[s - 1])) {
+			s--;
+		}
+		while (e < text.length && isWordChar(text[e])) {
+			e++;
+		}
+		return text.slice(s, e);
+	}
+
+	private isEmptyLine(p: VimPos): boolean {
+		return p.col === 0 && this.len(p.line) === 0;
+	}
+
+	private wordForward(start: VimPos, big: boolean): VimPos {
+		let p = start;
+		const cls = charClass(this.charAt(p), big);
+		if (cls !== 0) {
+			for (; ;) {
+				const nx = this.nextChar(p);
+				if (!nx) {
+					return pos(p.line, this.len(p.line));
+				}
+				p = nx;
+				if (charClass(this.charAt(p), big) !== cls) {
+					break;
+				}
+			}
+		}
+		let moved = cmp(p, start) !== 0;
+		while (charClass(this.charAt(p), big) === 0) {
+			if (moved && this.isEmptyLine(p)) {
+				break;
+			}
+			const nx = this.nextChar(p);
+			if (!nx) {
+				return pos(p.line, this.len(p.line));
+			}
+			p = nx;
+			moved = true;
+		}
+		return p;
+	}
+
+	private wordBackward(start: VimPos, big: boolean): VimPos {
+		const first = this.prevChar(start);
+		if (!first) {
+			return start;
+		}
+		let p: VimPos = first;
+		while (charClass(this.charAt(p), big) === 0 && !this.isEmptyLine(p)) {
+			const pv = this.prevChar(p);
+			if (!pv) {
+				return p;
+			}
+			p = pv;
+		}
+		if (this.isEmptyLine(p)) {
+			return p;
+		}
+		const cls = charClass(this.charAt(p), big);
+		for (; ;) {
+			if (p.col === 0) {
+				return p;
+			}
+			const pv = this.prevChar(p)!;
+			if (charClass(this.charAt(pv), big) !== cls) {
+				return p;
+			}
+			p = pv;
+		}
+	}
+
+	/** End of the n-th word; `stayIfAtEnd` is the `cw` rule (count the current word). */
+	private wordEnd(start: VimPos, big: boolean, n: number, stayIfAtEnd: boolean): VimPos {
+		let p = start;
+		for (let c = 0; c < n; c++) {
+			if (!(stayIfAtEnd && c === 0 && charClass(this.charAt(p), big) !== 0)) {
+				const nx = this.nextChar(p);
+				if (!nx) {
+					return p;
+				}
+				p = nx;
+				while (charClass(this.charAt(p), big) === 0) {
+					const nn = this.nextChar(p);
+					if (!nn) {
+						return this.clampNormal(p);
+					}
+					p = nn;
+				}
+			}
+			const cls = charClass(this.charAt(p), big);
+			for (; ;) {
+				const nx = this.nextChar(p);
+				if (!nx || nx.line !== p.line || charClass(this.charAt(nx), big) !== cls) {
+					break;
+				}
+				p = nx;
+			}
+		}
+		return p;
+	}
+
+	private wordEndBackward(start: VimPos, big: boolean, n: number): VimPos {
+		let p = start;
+		for (let c = 0; c < n; c++) {
+			const cls = charClass(this.charAt(p), big);
+			// leave the current word
+			while (charClass(this.charAt(p), big) === cls && cls !== 0) {
+				const pv = this.prevChar(p);
+				if (!pv) {
+					return p;
+				}
+				p = pv;
+			}
+			while (charClass(this.charAt(p), big) === 0 && !this.isEmptyLine(p)) {
+				const pv = this.prevChar(p);
+				if (!pv) {
+					return p;
+				}
+				p = pv;
+			}
+		}
+		return p;
+	}
+
+	private findInLine(cur: VimPos, key: string, ch: string, n: number, repeat: boolean): MotionResult | undefined {
+		const text = this.host.lineText(cur.line);
+		const forward = key === 'f' || key === 't';
+		const till = key === 't' || key === 'T';
+		let idx = cur.col;
+		for (let c = 0; c < n; c++) {
+			let from = forward ? idx + 1 : idx - 1;
+			// A repeated `t` must not stick in front of the char it already reached.
+			if (c === 0 && till && repeat) {
+				from = forward ? idx + 2 : idx - 2;
+			}
+			idx = forward ? text.indexOf(ch, from) : (from < 0 ? -1 : text.lastIndexOf(ch, from));
+			if (idx < 0) {
+				return undefined;
+			}
+		}
+		const col = till ? (forward ? idx - 1 : idx + 1) : idx;
+		return { pos: pos(cur.line, col), inclusive: forward };
+	}
+
+	private matchBracket(cur: VimPos): MotionResult | undefined {
+		const text = this.host.lineText(cur.line);
+		let col = cur.col;
+		while (col < text.length && !'()[]{}'.includes(text[col])) {
+			col++;
+		}
+		if (col >= text.length) {
+			return undefined;
+		}
+		const ch = text[col];
+		const [open, close] = BRACKETS[ch];
+		const found = ch === open ? this.scanBracket(pos(cur.line, col), open, close, true) : this.scanBracket(pos(cur.line, col), open, close, false);
+		return found ? { pos: found, inclusive: true } : undefined;
+	}
+
+	/** From a bracket at `from`, find its partner, walking lines lazily. */
+	private scanBracket(from: VimPos, open: string, close: string, forward: boolean): VimPos | undefined {
+		let depth = 0;
+		const last = this.lastLine();
+		for (let line = from.line; forward ? line <= last : line >= 0; line += forward ? 1 : -1) {
+			const text = this.host.lineText(line);
+			let col = line === from.line ? from.col : (forward ? 0 : text.length - 1);
+			for (; forward ? col < text.length : col >= 0; col += forward ? 1 : -1) {
+				const c = text[col];
+				if (c === (forward ? open : close)) {
+					depth++;
+				} else if (c === (forward ? close : open)) {
+					depth--;
+					if (depth === 0) {
+						return pos(line, col);
+					}
+				}
+			}
+		}
+		return undefined;
+	}
+
+	/** Unmatched `open` before `cur` (or at it). */
+	private enclosingOpen(cur: VimPos, open: string, close: string): VimPos | undefined {
+		if (this.charAt(cur) === open) {
+			return cur;
+		}
+		let depth = 0;
+		let p: VimPos | undefined = this.charAt(cur) === close ? this.prevChar(cur) : cur;
+		while (p) {
+			const c = this.charAt(p);
+			if (c === close) {
+				depth++;
+			} else if (c === open) {
+				if (depth === 0) {
+					return p;
+				}
+				depth--;
+			}
+			p = this.prevChar(p);
+		}
+		return undefined;
+	}
+
+	// ---- text objects -------------------------------------------------------
+
+	private textObject(kind: string, ch: string, count: number, cur: VimPos): Range | undefined {
+		if (ch === 'w' || ch === 'W') {
+			return this.wordObject(kind === 'a', ch === 'W', cur);
+		}
+		if (QUOTES.has(ch)) {
+			return this.quoteObject(kind === 'a', ch, cur);
+		}
+		const pair = BRACKETS[ch];
+		if (pair) {
+			let p: VimPos | undefined = cur;
+			let openPos: VimPos | undefined;
+			for (let c = 0; c < count && p; c++) {
+				openPos = this.enclosingOpen(p, pair[0], pair[1]);
+				p = openPos ? this.prevChar(openPos) : undefined;
+			}
+			if (!openPos) {
+				return undefined;
+			}
+			const closePos = this.scanBracket(openPos, pair[0], pair[1], true);
+			if (!closePos) {
+				return undefined;
+			}
+			if (kind === 'a') {
+				return { start: openPos, end: pos(closePos.line, closePos.col + 1), linewise: false };
+			}
+			let start = pos(openPos.line, openPos.col + 1);
+			let end = closePos;
+			// `{` at line end and `}` alone on its line: the inner lines, linewise.
+			if (start.col === this.len(start.line) && start.line < end.line && this.firstNonBlank(end.line) === end.col) {
+				if (end.line - start.line < 2) {
+					return { start: pos(start.line + 1, 0), end: pos(start.line + 1, 0), linewise: false };
+				}
+				return { start: pos(start.line + 1, 0), end: pos(end.line - 1, this.len(end.line - 1)), linewise: true };
+			}
+			if (cmp(start, end) > 0) {
+				start = end;
+			}
+			return { start, end, linewise: false };
+		}
+		return undefined;
+	}
+
+	private wordObject(around: boolean, big: boolean, cur: VimPos): Range | undefined {
+		const text = this.host.lineText(cur.line);
+		if (text.length === 0) {
+			return undefined;
+		}
+		const col = Math.min(cur.col, text.length - 1);
+		const cls = charClass(text[col], big);
+		let s = col;
+		let e = col + 1;
+		while (s > 0 && charClass(text[s - 1], big) === cls) {
+			s--;
+		}
+		while (e < text.length && charClass(text[e], big) === cls) {
+			e++;
+		}
+		if (around) {
+			if (cls === 0) {
+				// on blanks: blanks plus the following word
+				if (e < text.length) {
+					const c2 = charClass(text[e], big);
+					while (e < text.length && charClass(text[e], big) === c2) {
+						e++;
+					}
+				}
+			} else {
+				const e0 = e;
+				while (e < text.length && charClass(text[e], big) === 0) {
+					e++;
+				}
+				if (e === e0) {
+					while (s > 0 && charClass(text[s - 1], big) === 0) {
+						s--;
+					}
+				}
+			}
+		}
+		return { start: pos(cur.line, s), end: pos(cur.line, e), linewise: false };
+	}
+
+	private quoteObject(around: boolean, q: string, cur: VimPos): Range | undefined {
+		const text = this.host.lineText(cur.line);
+		const quotes: number[] = [];
+		for (let c = 0; c < text.length; c++) {
+			if (text[c] === '\\') {
+				c++;
+				continue;
+			}
+			if (text[c] === q) {
+				quotes.push(c);
+			}
+		}
+		let pair: [number, number] | undefined;
+		for (let j = 0; j + 1 < quotes.length; j += 2) {
+			if (quotes[j] <= cur.col && cur.col <= quotes[j + 1]) {
+				pair = [quotes[j], quotes[j + 1]];
+				break;
+			}
+		}
+		if (!pair) {
+			for (let j = 0; j + 1 < quotes.length; j += 2) {
+				if (quotes[j] > cur.col) {
+					pair = [quotes[j], quotes[j + 1]];
+					break;
+				}
+			}
+		}
+		if (!pair) {
+			return undefined;
+		}
+		if (!around) {
+			return { start: pos(cur.line, pair[0] + 1), end: pos(cur.line, pair[1]), linewise: false };
+		}
+		let e = pair[1] + 1;
+		let s = pair[0];
+		if (e < text.length && /\s/.test(text[e])) {
+			while (e < text.length && /\s/.test(text[e])) {
+				e++;
+			}
+		} else {
+			while (s > 0 && /\s/.test(text[s - 1])) {
+				s--;
+			}
+		}
+		return { start: pos(cur.line, s), end: pos(cur.line, e), linewise: false };
+	}
+
+	// ---- visual mode --------------------------------------------------------
+
+	private visualRange(): Range {
+		const [a, b] = cmp(this.visualAnchor, this.visualHead) <= 0 ? [this.visualAnchor, this.visualHead] : [this.visualHead, this.visualAnchor];
+		if (this._mode === 'visualLine') {
+			return { start: pos(a.line, 0), end: pos(b.line, this.len(b.line)), linewise: true };
+		}
+		const end = b.col < this.len(b.line) ? pos(b.line, b.col + 1) : (this.nextChar(b) ?? b);
+		return { start: a, end, linewise: false };
+	}
+
+	private renderVisual(): void {
+		const r = this.visualRange();
+		const backwards = cmp(this.visualHead, this.visualAnchor) < 0;
+		this.host.setSelection(r.start, r.end, backwards);
+	}
+
+	private runVisual(k: string[]): Parse {
+		let i = 0;
+		let register: string | undefined;
+		if (k[i] === '"') {
+			this.host.prefetchClipboard();
+			if (k.length < 2) {
+				return { status: 'incomplete' };
+			}
+			register = k[1];
+			i = 2;
+		}
+		let count: number | undefined;
+		while (i < k.length && /^[0-9]$/.test(k[i]) && !(k[i] === '0' && count === undefined)) {
+			count = (count ?? 0) * 10 + Number(k[i]);
+			i++;
+		}
+		if (i >= k.length) {
+			return { status: 'incomplete' };
+		}
+		const key = k[i];
+		const head = this.visualHead;
+
+		if ((key === 'i' || key === 'a')) {
+			if (k.length < i + 2) {
+				return { status: 'incomplete' };
+			}
+			const r = this.textObject(key, k[i + 1], count ?? 1, head);
+			if (!r) {
+				return { status: 'invalid' };
+			}
+			if (r.linewise) {
+				this._mode = 'visualLine';
+			}
+			this.visualAnchor = r.start;
+			this.visualHead = r.linewise ? r.end : (this.prevChar(r.end) ?? r.end);
+			this.renderVisual();
+			return { status: 'done' };
+		}
+
+		const motion = this.parseMotion(k, i, count, false, head);
+		if (motion.status === 'incomplete') {
+			return motion;
+		}
+		if (motion.status === 'ok') {
+			if (motion.result) {
+				const r = motion.result;
+				const target = r.vertical ? pos(r.pos.line, this.desiredColFor(r.pos.line)) : r.pos;
+				this.visualHead = this.clampNormal(target);
+				if (!r.vertical) {
+					this.desiredCol = this.visualHead.col;
+				}
+				this.renderVisual();
+			}
+			return { status: 'done' };
+		}
+
+		const range = this.visualRange();
+		const leave = (cursor: VimPos) => {
+			this._mode = 'normal';
+			this.setNormalCursor(cursor);
+		};
+		switch (key) {
+			case 'o': {
+				[this.visualAnchor, this.visualHead] = [this.visualHead, this.visualAnchor];
+				this.renderVisual();
+				return { status: 'done' };
+			}
+			case 'v': case 'V': {
+				const target: VimMode = key === 'v' ? 'visual' : 'visualLine';
+				if (this._mode === target) {
+					leave(this.visualHead);
+				} else {
+					this._mode = target;
+					this.renderVisual();
+				}
+				return { status: 'done' };
+			}
+			case 'd': case 'x': case 'X': case 'D': case 'y': case 'Y': case 'c': case 's': case 'S': case 'C': case 'R': {
+				const op = key === 'y' || key === 'Y' ? 'y' : 'cCsSR'.includes(key) ? 'c' : 'd';
+				const linewise = range.linewise || 'XDYSCR'.includes(key);
+				const r: Range = linewise ? { start: pos(range.start.line, 0), end: pos(range.end.line, this.len(range.end.line)), linewise: true } : range;
+				this._mode = 'normal';
+				this.applyOperator(op, register, r, r.start);
+				if (op !== 'c') {
+					this.setNormalCursor(op === 'y' ? r.start : this.host.getCursor());
+				}
+				return { status: 'done' };
+			}
+			case '>': case '<': {
+				this._mode = 'normal';
+				for (let c = 0; c < (count ?? 1); c++) {
+					this.shift(range.start.line, range.end.line, key === '>');
+				}
+				this.closeChange();
+				return { status: 'done' };
+			}
+			case 'J': {
+				this._mode = 'normal';
+				this.join(range.start.line, Math.max(2, range.end.line - range.start.line + 1));
+				return { status: 'done' };
+			}
+			case '~': case 'u': case 'U': {
+				const text = this.getText(range.start, range.end);
+				const out = key === '~' ? toggleCase(text) : key === 'u' ? text.toLowerCase() : text.toUpperCase();
+				this.edit([{ start: range.start, end: range.end, text: out }]);
+				this.closeChange();
+				leave(range.start);
+				return { status: 'done' };
+			}
+			case 'p': case 'P': {
+				const reg = this.readRegister(register);
+				if (!reg) {
+					return { status: 'invalid' };
+				}
+				const replaced = this.getText(range.start, range.end);
+				let text = reg.text;
+				if (reg.linewise && !range.linewise) {
+					text = '\n' + text + '\n';
+				}
+				this.edit([{ start: range.start, end: range.end, text }]);
+				this.closeChange();
+				this.writeRegister(undefined, replaced, range.linewise, false);
+				leave(range.start);
+				return { status: 'done' };
+			}
+			case ':': case '/': case '?': {
+				if (key === ':') {
+					leave(this.visualHead);
+				}
+				this.cmdline = { kind: key, text: '' };
+				return { status: 'done' };
+			}
+			case 'g': {
+				if (k.length < i + 2) {
+					return { status: 'incomplete' };
+				}
+				return { status: 'invalid' };
+			}
+		}
+		return { status: 'invalid' };
+	}
+
+	// ---- the `:` / `/` prompt ----------------------------------------------
+
+	private cmdlineKey(key: string): void {
+		const cl = this.cmdline!;
+		if (key === '<Esc>') {
+			this.cmdline = undefined;
+			return;
+		}
+		if (key === '<BS>') {
+			if (!cl.text) {
+				this.cmdline = undefined;
+			} else {
+				cl.text = cl.text.slice(0, -1);
+			}
+			return;
+		}
+		if (key === '<CR>') {
+			this.cmdline = undefined;
+			if (cl.kind === ':') {
+				this.exCommand(cl.text.trim());
+			} else {
+				this.search(cl.text, cl.kind === '?', cl.operator);
+			}
+			return;
+		}
+		if (key.length === 1) {
+			cl.text += key;
+		}
+	}
+
+	private search(text: string, backwards: boolean, operator?: { op: string; register: string | undefined }): void {
+		const pattern = text || this.shared.lastSearch?.pattern;
+		if (!pattern) {
+			return;
+		}
+		this.shared.lastSearch = { pattern, backwards };
+		const cur = this.cursor();
+		const res = this.searchMotion(pattern, backwards, cur, 1);
+		if (!res) {
+			return;
+		}
+		if (operator) {
+			this.applyOperator(operator.op, operator.register, this.motionRange(cur, res), cur);
+			return;
+		}
+		if (this._mode === 'visual' || this._mode === 'visualLine') {
+			this.visualHead = res.pos;
+			this.renderVisual();
+		} else {
+			this.setNormalCursor(res.pos);
+		}
+	}
+
+	private exCommand(cmd: string): void {
+		if (!cmd) {
+			return;
+		}
+		if (/^\d+$/.test(cmd)) {
+			const line = Math.max(0, Math.min(this.lastLine(), Number(cmd) - 1));
+			this.setNormalCursor(pos(line, this.firstNonBlank(line)));
+			return;
+		}
+		if (cmd === '$') {
+			const line = this.lastLine();
+			this.setNormalCursor(pos(line, this.firstNonBlank(line)));
+			return;
+		}
+		if (cmd === 'noh' || cmd === 'nohlsearch') {
+			return;
+		}
+		if (!this.host.exCommand(cmd)) {
+			this.message = `Not an editor command: ${cmd}`;
+		}
+	}
+}
+
+function toggleCase(s: string): string {
+	let out = '';
+	for (const ch of s) {
+		const up = ch.toUpperCase();
+		out += ch === up ? ch.toLowerCase() : up;
+	}
+	return out;
+}
