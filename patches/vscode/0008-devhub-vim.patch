+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) DevHub contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+// DevHub native Vim: the editor-independent state machine.
+//
+// The engine does not read keys. It is driven by commands with arguments
+// (`devhubVim.motion { motion: 'wordForward' }`, `devhubVim.operator
+// { operator: 'delete' }`, ...), which the workbench binds to keys as
+// ordinary keybindings (common/vimKeymap.ts holds the defaults). What makes
+// it Vim is the grammar state it keeps between commands - count, register,
+// pending operator, pending text object (`i`/`a`), a command waiting for a
+// character (f t r " q @), visual range, the last change and macros - and
+// publishes as context keys (`context()`), so that a keybinding's `when` can
+// tell, e.g., `0` the count digit from `0` the motion. Composition happens
+// here: `d` only marks an operator as pending, and whatever motion or text
+// object command comes next completes it, whichever key ran it. `.` and
+// macros replay the recorded commands (with the characters they captured and
+// the text typed in insert mode), never keys, so remapping keys cannot break
+// them.
+//
+// This file imports nothing but the ex table, on purpose: it is the whole of
+// Vim's grammar against a small `IVimHost` that reads lines and applies edits.
+// The browser half (../browser/devhubVim.contribution.ts) implements the host
+// on top of a CodeEditorWidget and ITextModel; the tests implement it on a
+// string array. Nothing here copies the document: every motion reads the
+// lines it walks over, one `lineText()` at a time, so a command in a large
+// file costs what the motion touches, not the file size.
+//
+// Positions are 0-based { line, col }; `col === lineText(line).length` is the
+// position of the line break. Edit ranges are end-exclusive.
+
+import type { ExCommandEntry, ExStep, UserExCommands } from './vimEx.js';
+import { BUILTIN_EX_COMMANDS, completeExName, expandExEntry, parseExLine, resolveExAddress, validateUserExCommands } from './vimEx.js';
+
+export interface VimPos {
+	readonly line: number;
+	readonly col: number;
+}
+
+export interface VimEdit {
+	readonly start: VimPos;
+	readonly end: VimPos;
+	readonly text: string;
+}
+
+export type VimMode = 'normal' | 'insert' | 'visual' | 'visualLine';
+
+/** `devhubVim.mode` as the engine sees it (the workbench adds `nav` and `''`). */
+export type VimContextMode = VimMode | 'operatorPending' | 'cmdline';
+
+/** The engine's context keys (`devhubVim.<name>`), recomputed after every command. */
+export interface VimContext {
+	readonly mode: VimContextMode;
+	/** A motion, operator, count or action may come next (normal, visual or operator-pending; nothing captures the next key). */
+	readonly acceptsMotion: boolean;
+	readonly hasCount: boolean;
+	/** A count, register, operator, text object prefix or character argument is pending. */
+	readonly pending: boolean;
+	/** The pending operator's name (`delete`, ...) or ''. */
+	readonly pendingOperator: string;
+	/** `inner` or `around` after `i` / `a`, or ''. */
+	readonly textObjectPending: string;
+	/** The next key or IME commit is a character argument (f t r " q @ ...). */
+	readonly awaitingChar: boolean;
+	/** A macro is being recorded. */
+	readonly recording: boolean;
+}
+
+export interface IVimHost {
+	lineCount(): number;
+	lineText(line: number): string;
+	getCursor(): VimPos;
+	setCursor(pos: VimPos): void;
+	/** Show a selection; `end` is exclusive. `cursorAtStart` puts the caret at `start`. */
+	setSelection(start: VimPos, end: VimPos, cursorAtStart: boolean): void;
+	/** Apply non-overlapping edits (in pre-edit coordinates) synchronously. */
+	applyEdits(edits: readonly VimEdit[]): void;
+	/** Brackets one Vim change so that `u` undoes it as a single step. */
+	beginChange(): void;
+	endChange(): void;
+	undo(): void;
+	redo(): void;
+	indentUnit(): string;
+	tabSize(): number;
+	visibleLineCount(): number;
+	setClipboard(text: string): void;
+	/** Last known system clipboard text; `prefetchClipboard` refreshes it. */
+	getClipboard(): string;
+	prefetchClipboard(): void;
+	/** Start of the next match of `pattern` from `from` (wrapping), or undefined. */
+	find(pattern: string, from: VimPos, backwards: boolean): VimPos | undefined;
+	/** Run a command that is not the engine's own (ex commands, `awaitChar` targets). */
+	executeCommand(command: string, args: unknown): Promise<unknown>;
+	/** Something finished asynchronously (an ex command): show the new state. */
+	refresh(): void;
+}
+
+export interface VimRegister {
+	readonly text: string;
+	readonly linewise: boolean;
+}
+
+/** One executed engine command, as `.` and macros replay it. */
+export interface VimStep {
+	readonly command: string;
+	readonly args: Readonly<Record<string, unknown>>;
+}
+
+/** State Vim keeps per window rather than per buffer: registers, macros, last search, last f/t, ex commands. */
+export class VimSharedState {
+	readonly registers = new Map<string, VimRegister>();
+	readonly macros = new Map<string, readonly VimStep[]>();
+	lastMacro: string | undefined;
+	lastSearch: { pattern: string; backwards: boolean } | undefined;
+	lastFind: { key: string; char: string } | undefined;
+	private userEx: UserExCommands = validateUserExCommands(undefined);
+
+	/** The `devhub.vim.exCommands` setting. */
+	setUserExCommands(raw: unknown): void {
+		this.userEx = validateUserExCommands(raw);
+	}
+
+	/** The entry for `name`, or a message saying why there is none. */
+	lookupEx(name: string): { readonly entry: ExCommandEntry } | { readonly error: string } {
+		const error = this.userEx.errors.get(name);
+		const user = this.userEx.table.get(name);
+		if (user !== undefined) {
+			return { entry: user };
+		}
+		if (Object.prototype.hasOwnProperty.call(BUILTIN_EX_COMMANDS, name)) {
+			return { entry: BUILTIN_EX_COMMANDS[name] };
+		}
+		return { error: error ?? `Not an editor command: ${name}` };
+	}
+
+	exNames(): string[] {
+		return [...Object.keys(BUILTIN_EX_COMMANDS), ...this.userEx.table.keys()];
+	}
+}
+
+/** Every command the engine executes; the workbench registers each one. */
+export const VIM_ENGINE_COMMANDS = [
+	'devhubVim.motion',
+	'devhubVim.operator',
+	'devhubVim.textObjectPrefix',
+	'devhubVim.textObject',
+	'devhubVim.count',
+	'devhubVim.register',
+	'devhubVim.awaitChar',
+	'devhubVim.mode',
+	'devhubVim.action',
+	'devhubVim.cmdline',
+	'devhubVim.search',
+	'devhubVim.ex',
+	'devhubVim.insertText',
+	'devhubVim.escape',
+] as const;
+
+export type VimEngineCommand = typeof VIM_ENGINE_COMMANDS[number];
+
+interface Range {
+	start: VimPos;
+	end: VimPos; // exclusive
+	linewise: boolean;
+}
+
+interface MotionResult {
+	pos: VimPos;
+	linewise?: boolean;
+	inclusive?: boolean;
+	/** j/k-style motions keep the remembered column. */
+	vertical?: boolean;
+}
+
+interface LastChange {
+	register: string | undefined;
+	count: number | undefined;
+	steps: VimStep[];
+	insertText?: string;
+}
+
+type Args = Readonly<Record<string, unknown>>;
+
+/** Operator names (the command argument) and the letter Vim shows for them. */
