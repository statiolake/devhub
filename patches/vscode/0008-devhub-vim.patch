+	'devhubVim.cmdline': localize('devhubVim.cmd.cmdline', "Vim: open the prompt { kind: ':' | '/' | '?' }"),
+	'devhubVim.search': localize('devhubVim.cmd.search', "Vim: search { pattern, backwards? }"),
+	'devhubVim.ex': localize('devhubVim.cmd.ex', "Vim: run an ex command line { command }"),
+	'devhubVim.insertText': localize('devhubVim.cmd.insertText', "Vim: insert text in insert mode { text } (macro replay)"),
+	'devhubVim.escape': localize('devhubVim.cmd.escape', "Vim: Esc (cancel one thing; always ends in normal mode)"),
+	'devhubVim.substituteConfirm': localize('devhubVim.cmd.substituteConfirm', "Vim: answer the :s///c question { char: y | n | a | q | l }"),
+};
+
+for (const id of VIM_ENGINE_COMMANDS) {
+	CommandsRegistry.registerCommand({
+		id,
+		handler: (_accessor, args: unknown) => DevhubVim.instance?.execute(id, args),
+		metadata: { description: COMMAND_DESCRIPTIONS[id] ?? id, args: [{ name: 'args', isOptional: true, schema: { type: 'object' } }] },
+	});
+}
+
+/** keybindings.json notation ("shift+4", "g g", "g r n", "ctrl+r") to keybinding numbers (one per chord when there are more than two). */
+function encodeKeybinding(key: string): number | number[] | undefined {
+	const chords = key.split(' ').map(chord => {
+		const parts = chord.split('+');
+		const last = parts[parts.length - 1] === '' ? '+' : parts[parts.length - 1];
+		const keyCode = KeyCodeUtils.fromUserSettings(last);
+		if (keyCode === KeyCode.Unknown) {
+			return undefined;
+		}
+		let mods = 0;
+		for (const m of parts.slice(0, -1)) {
+			mods |= m === 'shift' ? KeyMod.Shift
+				: m === 'alt' ? KeyMod.Alt
+					: m === 'ctrl' ? (isMacintosh ? KeyMod.WinCtrl : KeyMod.CtrlCmd)
+						: (isMacintosh ? KeyMod.CtrlCmd : KeyMod.WinCtrl);
+		}
+		return mods | keyCode;
+	});
+	if (chords.some(c => c === undefined) || chords.length > 3) {
+		return undefined;
+	}
+	if (chords.length === 3) {
+		return chords as number[];
+	}
+	return chords.length === 2 ? KeyChord(chords[0]!, chords[1]!) : chords[0];
+}
+
+const WEIGHTS = {
+	default: KeybindingWeight.EditorContrib,
+	override: KeybindingWeight.WorkbenchContrib + 50,
+	escape: KeybindingWeight.EditorCore + 50,
+};
+
+for (const b of DEFAULT_KEYBINDINGS) {
+	const primary = encodeKeybinding(b.key);
+	const when = ContextKeyExpr.deserialize(effectiveWhen(b));
+	if (primary === undefined || !when) {
+		onUnexpectedError(new Error(`devhubVim: cannot register the default keybinding ${b.key} -> ${b.command}`));
+		continue;
+	}
+	KeybindingsRegistry.registerKeybindingRule({
+		id: b.command,
+		args: b.args,
+		// Three chords ("g r n"): the registry decodes an array of chords (decodeKeybinding), one number cannot hold them.
+		primary: primary as number,
+		when: ContextKeyExpr.and(ENABLED, when),
+		weight: WEIGHTS[b.weight ?? 'default'],
+	});
+}
+
+// The layout fallback's way out of chord mode (DevhubVim.leaveChordMode): the
+// first keys of the chords whose second key may be a shifted digit, then F24.
+CommandsRegistry.registerCommand('devhubVim.leaveChord', () => { });
+for (const first of [KeyCode.KeyG, KeyCode.BracketLeft, KeyCode.BracketRight]) {
+	KeybindingsRegistry.registerKeybindingRule({
+		id: 'devhubVim.leaveChord',
+		primary: KeyChord(first, KeyCode.F24),
+		when: ENABLED,
+		weight: WEIGHTS.default,
+	});
+}
+
+// ---- <C-w> window commands (all overridable) ---------------------------------
+
+const NAV = ContextKeyExpr.and(ENABLED, VIM_MODE.isEqualTo('nav'));
+
+interface Keys {
+	primary: number;
+	secondary?: number[];
+	mac?: { primary: number; secondary?: number[] };
+}
+
+/** Ctrl+key on every platform (KeyMod.WinCtrl is Ctrl on macOS, where CtrlCmd is Cmd). */
+function ctrl(key: KeyCode): number[] {
+	return [KeyMod.CtrlCmd | key, KeyMod.WinCtrl | key];
+}
+
+function rule(id: string, keys: Keys, when: ContextKeyExpression | undefined, weight: number, run: (vim: DevhubVim) => void): void {
+	KeybindingsRegistry.registerCommandAndKeybindingRule({
+		id, ...keys, when, weight,
+		handler: () => {
+			const vim = DevhubVim.instance;
+			if (vim) {
+				run(vim);
+			}
+		},
+	});
+}
+
+// The prefix, Ctrl-W. Not in a Vim editor's insert mode (Ctrl-W deletes a word
+// there, vimKeymap.ts), not in the terminal (the shell's Ctrl-W), not in quick
+// input. While Vim is on it outranks Ctrl-W's defaults: Switch Window on macOS
+// (Cmd-W, close editor, is another key and untouched), close editor elsewhere.
+const [ctrlW, macCtrlW] = ctrl(KeyCode.KeyW);
+rule('devhubVim.nav.enter', { primary: ctrlW, mac: { primary: macCtrlW } },
+	ContextKeyExpr.and(ENABLED, VIM_MODE.notEqualsTo('nav'),
+		ContextKeyExpr.or(VIM_ACTIVE.negate(), VIM_INSERT.negate()),
+		ContextKeyExpr.has('terminalFocus').negate(), ContextKeyExpr.has('inQuickInput').negate()),
+	KeybindingWeight.WorkbenchContrib + 50, vim => vim.enterNav());
+rule('devhubVim.nav.escape', { primary: KeyCode.Escape }, NAV, KeybindingWeight.EditorCore + 50, vim => vim.runNav([]));
+
+/** `<C-w>{key}`: [command id suffix, key, also with Ctrl held, shifted, commands it runs]. */
+const NAV_COMMANDS: readonly [string, KeyCode, boolean, boolean, readonly string[]][] = [
+	['left', KeyCode.KeyH, true, false, ['workbench.action.navigateLeft']],
+	['down', KeyCode.KeyJ, true, false, ['workbench.action.navigateDown']],
+	['up', KeyCode.KeyK, true, false, ['workbench.action.navigateUp']],
+	['right', KeyCode.KeyL, true, false, ['workbench.action.navigateRight']],
+	['leftArrow', KeyCode.LeftArrow, false, false, ['workbench.action.navigateLeft']],
+	['downArrow', KeyCode.DownArrow, false, false, ['workbench.action.navigateDown']],
+	['upArrow', KeyCode.UpArrow, false, false, ['workbench.action.navigateUp']],
+	['rightArrow', KeyCode.RightArrow, false, false, ['workbench.action.navigateRight']],
+	['next', KeyCode.KeyW, true, false, ['workbench.action.focusNextGroup']],
+	['previous', KeyCode.KeyW, false, true, ['workbench.action.focusPreviousGroup']],
+	['lastAccessed', KeyCode.KeyP, true, false, ['workbench.action.focusPreviousGroup']],
+	['top', KeyCode.KeyT, true, false, ['workbench.action.focusFirstEditorGroup']],
+	['bottom', KeyCode.KeyB, true, false, ['workbench.action.focusLastEditorGroup']],
+	['split', KeyCode.KeyS, true, false, ['workbench.action.splitEditorUp']],
+	['splitShift', KeyCode.KeyS, false, true, ['workbench.action.splitEditorUp']],
+	['vsplit', KeyCode.KeyV, true, false, ['workbench.action.splitEditorLeft']],
+	['new', KeyCode.KeyN, true, false, ['workbench.action.splitEditorUp', 'workbench.action.files.newUntitledFile']],
+	['close', KeyCode.KeyC, false, false, ['workbench.action.closeGroup']],
+	['quit', KeyCode.KeyQ, true, false, ['workbench.action.closeActiveEditor']],
+	['only', KeyCode.KeyO, true, false, ['workbench.action.closeEditorsInOtherGroups']],
+	['equalize', KeyCode.Equal, false, false, ['workbench.action.evenEditorWidths']],
+	['maximizeHeight', KeyCode.Minus, false, true, ['workbench.action.toggleMaximizeEditorGroup']],
+	['maximizeWidth', KeyCode.Backslash, false, true, ['workbench.action.toggleMaximizeEditorGroup']],
+	['increaseHeight', KeyCode.Equal, false, true, ['workbench.action.increaseViewHeight']],
+	['decreaseHeight', KeyCode.Minus, false, false, ['workbench.action.decreaseViewHeight']],
+	['decreaseWidth', KeyCode.Comma, false, true, ['workbench.action.decreaseViewWidth']],
+	['increaseWidth', KeyCode.Period, false, true, ['workbench.action.increaseViewWidth']],
+	['moveFarLeft', KeyCode.KeyH, false, true, ['workbench.action.moveActiveEditorGroupLeft']],
+	['moveFarDown', KeyCode.KeyJ, false, true, ['workbench.action.moveActiveEditorGroupDown']],
+	['moveFarUp', KeyCode.KeyK, false, true, ['workbench.action.moveActiveEditorGroupUp']],
+	['moveFarRight', KeyCode.KeyL, false, true, ['workbench.action.moveActiveEditorGroupRight']],
+	// Neovim: <C-w>d / <C-w><C-d> show the diagnostic at the cursor (CTRL-W_d-default)
+	['diagnostic', KeyCode.KeyD, true, false, ['editor.action.showHover']],
+	// 'tagfunc' is the language server's: <C-w>] splits to the definition, <C-w>} previews it
+	['definitionSplit', KeyCode.BracketRight, true, false, ['editor.action.revealDefinitionAside']],
+	['definitionPreview', KeyCode.BracketRight, false, true, ['editor.action.peekDefinition']],
+];
+for (const [name, key, withCtrl, shifted, commands] of NAV_COMMANDS) {
+	const k = shifted ? KeyMod.Shift | key : key;
+	const [c, macC] = ctrl(k);
+	rule(`devhubVim.nav.${name}`, withCtrl ? { primary: k, secondary: [c], mac: { primary: k, secondary: [macC] } } : { primary: k },
+		NAV, KeybindingWeight.WorkbenchContrib + 50, vim => vim.runNav(commands));
+}
