+/** What Shift + 1 2 ... 9 0 type on a US layout. */
+export const US_SHIFTED_DIGITS = '!@#$%^&*()';
+
+const SHIFTED_DIGIT_KEY = /^shift\+[0-9]$/;
+
+/** Whether the binding sits on a shifted digit, whose character depends on the layout. */
+export function isLayoutGated(b: VimKeybinding): boolean {
+	return b.key.split(' ').some(chord => SHIFTED_DIGIT_KEY.test(chord));
+}
+
+export const SHIFTED_DIGIT_GATE = 'devhubVim.usShiftedDigits';
+
+/** The when clause the binding is registered with. */
+export function effectiveWhen(b: VimKeybinding): string {
+	return isLayoutGated(b) ? `${b.when} && ${SHIFTED_DIGIT_GATE}` : b.when;
+}
+
+const US_SHIFTED_PUNCTUATION: Record<string, string> = {
+	'~': '`', '_': '-', '+': '=', '{': '[', '}': ']', '|': '\\', ':': ';', '"': '\'', '<': ',', '>': '.', '?': '/',
+};
+
+/** The US-layout keybinding notation for typing `ch` ('$' -> 'shift+4', 'G' -> 'shift+g', ' ' -> 'space'). */
+export function usKeyForChar(ch: string): string | undefined {
+	if (ch === ' ') {
+		return 'space';
+	}
+	if (/^[a-z0-9]$/.test(ch) || (ch.length === 1 && '`-=[]\\;\',./'.includes(ch))) {
+		return ch;
+	}
+	if (/^[A-Z]$/.test(ch)) {
+		return `shift+${ch.toLowerCase()}`;
+	}
+	const digit = US_SHIFTED_DIGITS.indexOf(ch);
+	if (digit >= 0 && ch.length === 1) {
+		return `shift+${(digit + 1) % 10}`;
+	}
+	const base = US_SHIFTED_PUNCTUATION[ch];
+	return base ? `shift+${base}` : undefined;
+}
+
+/**
+ * On a layout whose shifted digits are not US-like, the default entry for a
+ * US shifted-digit character (`^` -> the `shift+6` entry) whose when clause
+ * holds, if any: the editor runs it for a keydown that typed that character
+ * and that no keybinding took. `prefix` is the character typed before it when
+ * that key started a chord (`g` for `g*`, `[` for `[(`). Later entries win, as
+ * in the keybinding resolver.
+ */
+export function layoutFallbackBinding(ch: string, whenHolds: (when: string) => boolean, prefix?: string): VimKeybinding | undefined {
+	if (ch.length !== 1 || !US_SHIFTED_DIGITS.includes(ch)) {
+		return undefined;
+	}
+	const second = usKeyForChar(ch);
+	const first = prefix === undefined ? undefined : usKeyForChar(prefix);
+	if (prefix !== undefined && !first) {
+		return undefined;
+	}
+	const key = first ? `${first} ${second}` : second;
+	let found: VimKeybinding | undefined;
+	for (const b of DEFAULT_KEYBINDINGS) {
+		if (b.key === key && whenHolds(b.when)) {
+			found = b;
+		}
+	}
+	return found;
+}
+
+// ---- when clauses and key notation, for :normal and the tests ----------------
+
+/** Evaluate the subset of the when-clause language the keymap uses (`&&`, `||`, `!`, `==`, `!=`, parentheses). Unknown keys are undefined (false). */
+export function evaluateWhen(when: string, ctx: Readonly<Record<string, unknown>>): boolean {
+	const tokens = when.match(/\(|\)|&&|\|\||!=|==|!|'[^']*'|[\w.]+/g) ?? [];
+	let i = 0;
+	const value = (t: string): unknown => t.startsWith('\'') ? t.slice(1, -1) : t === 'true' ? true : t === 'false' ? false : ctx[t];
+	const primary = (): unknown => {
+		const t = tokens[i++];
+		if (t === '(') {
+			const v = or();
+			i++; // ')'
+			return v;
+		}
+		if (t === '!') {
+			return !primary();
+		}
+		const v = t === 'true' ? true : t === 'false' ? false : ctx[t];
+		if (tokens[i] === '==' || tokens[i] === '!=') {
+			const op = tokens[i++];
+			const rhs = value(tokens[i++]);
+			return op === '==' ? v === rhs : v !== rhs;
+		}
+		return v;
+	};
+	const and = (): unknown => {
+		let v = primary();
+		while (tokens[i] === '&&') {
+			i++;
+			const r = primary();
+			v = !!v && !!r;
+		}
+		return v;
+	};
+	const or = (): unknown => {
+		let v = and();
+		while (tokens[i] === '||') {
+			i++;
+			const r = and();
+			v = !!v || !!r;
+		}
+		return v;
+	};
+	return !!or();
+}
+
+const NAMED_KEY = /^<(?:Esc|CR|BS|Tab|Space|Left|Right|Up|Down|Del|Home|End|lt|Bar|Bslash|NL|[CcSsAaMmDd]-[^>]+)>/;
+
+/** Keys in Vim notation (`dw`, `<Esc>`, `<C-r>a`) one by one; `<lt>` is `<`, `<Bar>` `|`, `<Bslash>` `\`. */
+export function keysOf(s: string): string[] {
+	const out: string[] = [];
+	for (let i = 0; i < s.length;) {
+		if (s[i] === '<') {
+			const m = NAMED_KEY.exec(s.slice(i));
+			if (m) {
+				const k = m[0];
+				out.push(k === '<lt>' ? '<' : k === '<Bar>' ? '|' : k === '<Bslash>' ? '\\' : k === '<NL>' ? '<C-j>' : k);
+				i += k.length;
+				continue;
+			}
+		}
+		const cp = s.codePointAt(i)!;
+		const ch = String.fromCodePoint(cp);
+		out.push(ch);
+		i += ch.length;
+	}
+	return out;
+}
