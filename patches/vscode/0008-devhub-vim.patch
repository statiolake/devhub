+					c = 0;
+				}
+			} else {
+				const x = ic ? a.k.toLowerCase() : a.k;
+				const y = ic ? b.k.toLowerCase() : b.k;
+				c = x < y ? -1 : x > y ? 1 : 0;
+			}
+			return c || a.i - b.i;
+		});
