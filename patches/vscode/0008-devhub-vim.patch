+export class VimSharedState {
+	readonly registers = new Map<string, VimRegister>();
+	lastSearch: { pattern: string; backwards: boolean } | undefined;
+	lastFind: { key: string; char: string } | undefined;
+}
+
+interface Range {
+	start: VimPos;
+	end: VimPos; // exclusive
+	linewise: boolean;
+}
+
+interface MotionResult {
+	pos: VimPos;
+	linewise?: boolean;
+	inclusive?: boolean;
+	/** j/k-style motions keep the remembered column. */
+	vertical?: boolean;
+}
