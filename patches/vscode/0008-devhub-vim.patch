+						}
+						this.renderVisual();
+					}
+				} else if (this.isVisual()) {
+					const [first] = this.orderedVisual();
+					this.leaveVisual(first);
+				}
+			});
+			return;
+		}
+		this.runSteps(steps);
+	}
