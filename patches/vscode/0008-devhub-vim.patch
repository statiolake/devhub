+			const r = this.textObject(ch, around, n, cur);
+			if (!r) {
+				this.invalid(this.message);
+			}
+			this._mode = 'visual';
+			this.visualAnchor = r.start;
+			this.visualHead = this.prevChar(r.end) ?? r.end;
+			this.visualToEol = false;
+			if (ch === 'gN') {
