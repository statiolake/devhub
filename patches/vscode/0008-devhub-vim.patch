+ *--------------------------------------------------------------------------------------------*/
+
+// DevHub native Vim: keydown -> Vim key name, and the mode -> cursor style rule.
+// Imports nothing, so the tests run it as they run the engine.
+
+/** The parts of a KeyboardEvent the mapping reads. */
+export interface VimKeyEvent {
+	readonly key: string;
+	readonly keyCode: number;
+	readonly isComposing: boolean;
+	readonly ctrlKey: boolean;
+	readonly metaKey: boolean;
+	readonly altKey: boolean;
+}
+
+/**
+ * Map a keydown to Vim's key name, or undefined to let the editor have it.
+ * A key that belongs to an IME (229 / "Process", or one typed while composing)
+ * is never a Vim key: as in terminal Vim, an IME that is on composes, and only
+ * what it commits counts (VimEngine.handleText).
+ */
+export function toVimKey(e: VimKeyEvent, pending: boolean): string | undefined {
+	if (e.isComposing || e.keyCode === 229 || e.key === 'Process') {
+		return undefined;
+	}
+	if (e.metaKey || e.altKey) {
+		return undefined;
+	}
+	if (e.ctrlKey) {
+		const ctrl: Record<string, string> = { r: '<C-r>', d: '<C-d>', u: '<C-u>' };
+		return ctrl[e.key.toLowerCase()];
+	}
+	switch (e.key) {
+		case 'Enter': return '<CR>';
+		case 'Backspace': return '<BS>';
+		// Tab would run the editor's `tab` command, which indents: text reaching
+		// the model from normal mode. Vim gets it (and ignores it) instead.
+		case 'Tab': return '<Tab>';
+		case 'ArrowLeft': return pending ? undefined : 'h';
+		case 'ArrowRight': return pending ? undefined : 'l';
+		case 'ArrowUp': return pending ? undefined : 'k';
+		case 'ArrowDown': return pending ? undefined : 'j';
+	}
+	return e.key.length === 1 ? e.key : undefined;
+}
+
+export type VimCursorStyle = 'line' | 'block' | 'underline' | 'line-thin' | 'block-outline' | 'underline-thin';
+
+/**
+ * The one rule for the caret: the user's own style in insert mode, a block in
+ * every other Vim mode, a thin underline while Esc has left the text for
+ * navigation. Computed from the state each time (never toggled), so no
+ * sequence of events can leave a stale style behind.
+ */
+export function vimCursorStyle(mode: string, nav: boolean, insertStyle: VimCursorStyle): VimCursorStyle {
+	if (nav) {
+		return 'underline-thin';
+	}
+	return mode === 'insert' ? insertStyle : 'block';
+}
