+
+// DevHub native Vim: the editor-independent state machine.
+//
+// This file imports nothing, on purpose: it is the whole of Vim's grammar
+// (counts, registers, operators, motions, text objects, visual mode, `.`,
+// the `:`/`/` prompt) against a small `IVimHost` that reads lines and applies
+// edits. The browser half (../browser/devhubVim.contribution.ts) implements
+// the host on top of a CodeEditorWidget and ITextModel; the tests implement it
+// on a string array. Nothing here copies the document: every motion reads the
+// lines it walks over, one `lineText()` at a time, so a keystroke in a large
+// file costs what the motion touches, not the file size.
+//
+// Positions are 0-based { line, col }; `col === lineText(line).length` is the
+// position of the line break. Edit ranges are end-exclusive.
+
+export interface VimPos {
+	readonly line: number;
+	readonly col: number;
+}
+
+export interface VimEdit {
+	readonly start: VimPos;
+	readonly end: VimPos;
+	readonly text: string;
+}
+
+export type VimMode = 'normal' | 'insert' | 'visual' | 'visualLine';
+
+export interface IVimHost {
+	lineCount(): number;
+	lineText(line: number): string;
+	getCursor(): VimPos;
+	setCursor(pos: VimPos): void;
