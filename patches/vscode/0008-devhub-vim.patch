+			}
+			this.renderVisual();
+			this.complete(undefined);
+			return;
+		}
+		const range = this.textObject(ch, around, n, cur);
+		if (!range) {
+			this.invalid(this.message);
+		}
+		if (this.forced === 'line') {
+			range.linewise = true;
+			range.start = pos(range.start.line, 0);
+			range.end = pos(range.end.line, this.len(range.end.line));
