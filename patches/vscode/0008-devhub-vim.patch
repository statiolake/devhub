+					this.edit([{ start: from, end: at, text: '' }]);
+					this.host.setCursor(from);
+				}
+				if (last.insertText) {
+					this.typeText(last.insertText);
+				}
+				this.exitInsert(false);
+			}
+		} finally {
+			this.replaying = false;
+		}
+	}
