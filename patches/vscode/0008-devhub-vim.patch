+	awaitChar('shift+2', 'devhubVim.action', { action: 'playMacro' }, W.normal),
+];
+
+/** What Shift + 1 2 ... 9 0 type on a US layout. */
+export const US_SHIFTED_DIGITS = '!@#$%^&*()';
+
+const SHIFTED_DIGIT_KEY = /^shift\+[0-9]$/;
+
+/** Whether the binding sits on a shifted digit, whose character depends on the layout. */
+export function isLayoutGated(b: VimKeybinding): boolean {
+	return b.key.split(' ').some(chord => SHIFTED_DIGIT_KEY.test(chord));
+}
+
+export const SHIFTED_DIGIT_GATE = 'devhubVim.usShiftedDigits';
+
+/** The when clause the binding is registered with. */
+export function effectiveWhen(b: VimKeybinding): string {
+	return isLayoutGated(b) ? `${b.when} && ${SHIFTED_DIGIT_GATE}` : b.when;
+}
+
+const US_SHIFTED_PUNCTUATION: Record<string, string> = {
+	'~': '`', '_': '-', '+': '=', '{': '[', '}': ']', '|': '\\', ':': ';', '"': '\'', '<': ',', '>': '.', '?': '/',
+};
+
+/** The US-layout keybinding notation for typing `ch` ('$' -> 'shift+4', 'G' -> 'shift+g', ' ' -> 'space'). */
+export function usKeyForChar(ch: string): string | undefined {
+	if (ch === ' ') {
+		return 'space';
+	}
+	if (/^[a-z0-9]$/.test(ch) || (ch.length === 1 && '`-=[]\\;\',./'.includes(ch))) {
+		return ch;
+	}
+	if (/^[A-Z]$/.test(ch)) {
+		return `shift+${ch.toLowerCase()}`;
+	}
+	const digit = US_SHIFTED_DIGITS.indexOf(ch);
+	if (digit >= 0 && ch.length === 1) {
+		return `shift+${(digit + 1) % 10}`;
+	}
+	const base = US_SHIFTED_PUNCTUATION[ch];
+	return base ? `shift+${base}` : undefined;
+}
+
+/**
+ * On a layout whose shifted digits are not US-like, the default entry for a
+ * US shifted-digit character (`^` -> the `shift+6` entry) whose when clause
+ * holds, if any: the editor runs it for a keydown that typed that character
+ * and that no keybinding took. Later entries win, as in the keybinding
+ * resolver.
+ */
+export function layoutFallbackBinding(ch: string, whenHolds: (when: string) => boolean): VimKeybinding | undefined {
+	if (ch.length !== 1 || !US_SHIFTED_DIGITS.includes(ch)) {
+		return undefined;
+	}
+	const key = usKeyForChar(ch);
+	let found: VimKeybinding | undefined;
+	for (const b of DEFAULT_KEYBINDINGS) {
+		if (b.key === key && whenHolds(b.when)) {
+			found = b;
+		}
+	}
+	return found;
+}
