+// DevHub: the launcher this workbench's integrated terminal must run, or
+// undefined in a workbench nothing hosts.
+//
+// DevHub hosts this workbench, and its terminal is the tmux session DevHub
+// owns — not a shell the workbench chooses. It is per window, because a window
+// on a host must run the launcher written *there*, so DevHub names it on the
+// window configuration it opens the window with.
+//
+// From the *configuration*, not from `nodeProcess.env`. `preload.ts` does
+// `Object.assign(process.env, resolvedConfiguration.userEnv)`, but the
+// `process` a sandboxed renderer's preload sees materialises `env` from a
+// snapshot, so that assignment lands on a copy nothing reads back — every
+// window's `vscode.process.env['DEVHUB_TERMINAL']` was null while its
+// configuration held the right path. Nothing upstream noticed because nothing
+// upstream reads `userEnv` out of the renderer's environment. The window
+// configuration is the channel that actually carries a per-window fact, so it
+// is the only one DevHub uses.
+//
+// Read here, beside the other facts about the process this code is running in,
+// because the terminal profile service needs it synchronously in its
+// constructor, before any configuration has been read or any shell detected.
+// It is populated by then: the renderer awaits `resolveConfiguration()` before
+// it imports the workbench (`workbench.ts`, `load`), so the object this reads
+// exists before this module is evaluated.
+export const devhubTerminalLauncher: string | undefined = (typeof $globalThis.vscode !== 'undefined' && typeof $globalThis.vscode.context !== 'undefined'
+	? ($globalThis.vscode.context.configuration() as { devhubTerminalLauncher?: string } | undefined)?.devhubTerminalLauncher
+	: undefined) || undefined;
+
+// DevHub: where this workbench's DevHub terminal runs when that is not where the
+// workbench is attached, or undefined when it is.
+//
+// A workbench attached to a dev container has its extension host, its tasks
+// and its debugger in the container, and its DevHub terminal on the machine the
+// Workspace is on — the same direction as "Create New Integrated Terminal
+// (Local)". `cwd` is a directory on this Mac for the terminal to start in (a
+// `file:` cwd is what puts a terminal on the local backend); `args` are the
+// launcher's, and name the Workspace, because that directory cannot. Read from
+// the configuration for the reason `devhubTerminalLauncher` is.
+export const devhubTerminalLocal: { readonly cwd: string; readonly args: readonly string[] } | undefined = (typeof $globalThis.vscode !== 'undefined' && typeof $globalThis.vscode.context !== 'undefined'
+	? ($globalThis.vscode.context.configuration() as { devhubTerminalLocal?: { readonly cwd: string; readonly args: readonly string[] } } | undefined)?.devhubTerminalLocal
+	: undefined) || undefined;
+
+// DevHub: the name of the terminal profile that is DevHub's terminal, beside
+// the person's own profiles (`TerminalProfileService`).
+export const devhubTerminalProfileName = 'devhub';
+
+// DevHub: whether a terminal profile name is DevHub's own — in any case,
+// because the profile was called `DevHub` before, and a settings file written
+// then (Select Default Profile writes the profile it picked into
+// `terminal.integrated.profiles.<os>`) can still say so.
+export function isDevhubTerminalProfileName(name: string): boolean {
+	return name.toLowerCase() === devhubTerminalProfileName;
+}
