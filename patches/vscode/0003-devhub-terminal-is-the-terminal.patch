+// DevHub: the launcher this workbench's integrated terminal must run, or
+// undefined in a workbench nothing hosts.
+//
+// DevHub hosts this workbench, and its terminal is the tmux session DevHub
+// owns — not a shell the workbench chooses. DevHub puts the launcher's
+// absolute path in its own environment before it creates a window, so every
+// process descending from it reads the same answer. It is read here, beside
+// the other facts about the process this code is running in, because the
+// terminal profile service needs it synchronously in its constructor, before
+// any configuration has been read or any shell detected.
+export const devhubTerminalLauncher: string | undefined = nodeProcess?.env['DEVHUB_TERMINAL'] || undefined;
